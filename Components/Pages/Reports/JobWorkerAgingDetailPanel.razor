<div class="jwa-detail">
    <section><h2>JWO Summary</h2><p><b>@Detail.Summary.JwoNumber</b> · @Text(Detail.Summary.FinishedGoodNames) · @Text(Detail.Summary.Batch) · @Detail.Summary.DuePosition · @Detail.Summary.Status</p></section>
    <section class="jwa-stage-history"><h2>Production Stage &amp; Jobber History</h2><table class="data-grid" data-tt-filter-key="jwa-stages-@Detail.Summary.JwoVoucherId"><thead><tr><th>Stage</th><th>Process</th><th>Jobber</th><th>Assignment</th><th>Output</th><th>Ordered</th><th>Received</th><th>Pending</th><th>First MO</th><th>Last MO</th><th>Material Age</th><th>Status</th></tr></thead><tbody>@foreach(var x in Detail.Stages){<tr><td>@x.StagePath · @x.StageName</td><td>@Text(x.ProcessName)</td><td>@Text(x.JobWorkerName)</td><td>v@x.AssignmentVersion</td><td>@x.OutputItemName</td><td>@Qty(x.OrderedQuantity, x.UqcName)</td><td>@Qty(x.ReceivedQuantity, x.UqcName)</td><td>@Qty(x.PendingQuantity, x.UqcName)</td><td>@Date(x.FirstMaterialOutDate)</td><td>@Date(x.LastMaterialOutDate)</td><td>@Days(x.OldestOutstandingMaterialAge)</td><td>@x.Status</td></tr>}</tbody></table></section>
    <section><h2>Finished Goods</h2><table class="data-grid" data-tt-filter-key="jwa-finished-goods-@Detail.Summary.JwoVoucherId"><thead><tr><th>FG</th><th>Colour</th><th>Size</th><th>UQC</th><th>Ordered</th><th>Received</th><th>Pending</th></tr></thead><tbody>@foreach(var x in Detail.FinishedGoods){<tr><td>@x.FinishedGoodName</td><td>@x.ColourName</td><td>@x.SizeName</td><td>@x.UqcName</td><td>@x.OrderedQuantity</td><td>@x.ReceivedQuantity</td><td>@x.PendingQuantity</td></tr>}</tbody></table></section>
    <section><h2>Material Position</h2><table class="data-grid" data-tt-filter-key="jwa-materials-@Detail.Summary.JwoVoucherId"><thead><tr><th>Material</th><th>UQC</th><th>Required</th><th>Issued</th><th>Consumed</th><th>Balance</th><th>Oldest Age</th></tr></thead><tbody>@foreach(var x in Detail.Materials){<tr><td>@x.MaterialName</td><td>@x.UqcName</td><td>@x.RequiredQuantity</td><td>@x.IssuedQuantity</td><td>@x.ConsumedQuantity</td><td>@x.BalanceQuantity</td><td>@Days(x.OldestOutstandingAge)</td></tr>}</tbody></table></section>
    <section><h2>Material Out Lots</h2><table class="data-grid" data-tt-filter-key="jwa-material-lots-@Detail.Summary.JwoVoucherId"><thead><tr><th>MO No.</th><th>Date</th><th>Process / Stage</th><th>Jobber</th><th>Material</th><th>UQC</th><th>Issued</th><th>Consumed</th><th>Outstanding</th><th>Actual Age</th></tr></thead><tbody>@foreach(var x in Detail.MaterialLots){<tr><td><a href="@MoUrl(x.MaterialOutVoucherId)">@x.MaterialOutNumber</a></td><td>@Date(x.MaterialOutDate)</td><td>@Text(string.IsNullOrWhiteSpace(x.ProcessName) ? x.StageName : x.ProcessName)</td><td>@Text(x.JobWorkerName)</td><td>@x.MaterialName</td><td>@x.UqcName</td><td>@x.IssuedQuantity</td><td>@x.ConsumedQuantity</td><td>@x.OutstandingQuantity</td><td>@Days(x.AgeDays)</td></tr>}</tbody></table></section>
    <section><h2>Movement Summary</h2><p>Last MO: @Date(Detail.Summary.LastMaterialOutDate) · Last MI: @Date(Detail.Summary.LastMaterialInDate) · Last movement: @Date(Detail.Summary.LastMovementDate) · @Days(Detail.Summary.DaysSinceLastMovement) since movement</p></section>
</div>

@code {
    [Parameter, EditorRequired] public JobWorkerAgingDetail Detail { get; set; } = null!;
    [Parameter] public string ReturnUrl { get; set; } = "/reports/job-worker-aging";
    private static string Date(DateOnly value) => value.ToString("dd-MM-yyyy");
    private static string Date(DateOnly? value) => value?.ToString("dd-MM-yyyy") ?? "—";
    private static string Days(int? value) => value is null ? "—" : $"{value} days";
    private static string Text(string value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
    private static string Qty(decimal value, string uqc) => $"{value:0.####} {uqc}";
    private string MoUrl(long id) => $"/vouchers/material-out?voucherId={id}&returnUrl={Uri.EscapeDataString(ReturnUrl)}";
}
