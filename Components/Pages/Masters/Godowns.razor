@page "/masters/godowns"
@attribute [Authorize(Policy = SecurityPolicies.ManageMasters)]
@inject MasterRepository Repository
@inject DatabaseStatus Database
@inject IJSRuntime JS
@inject NavigationManager Navigation

<PageTitle>Godowns</PageTitle>

<div id="godown-page-root" class="page-card master-page" tabindex="0" @ref="pageRoot" @onkeydown="HandlePageKeyDown" @onkeydown:preventDefault="true">
    <KeyboardContextScope ContextId="godowns-list" RootElementId="godown-page-root"
                          ContextType="KeyboardContextType.List" Mode="KeyboardContextMode.List"
                          CanDelete="@(selectedIndex >= 0 && !busy)" DeleteAsync="DeleteSelected" />
    <div class="page-header">
        <div><p class="eyebrow">INVENTORY MASTER</p><h1>Godowns</h1></div>
        <div class="header-actions">
            <button class="primary-button" type="button" @onclick="OpenCreate" disabled="@(!Database.IsConnected || busy)">Alt+C Create</button>
            <button type="button" @onclick="OpenEdit" disabled="@(selectedIndex < 0 || busy)">Enter Edit</button>
            <button type="button" class="danger-button" @onclick="DeleteSelected" disabled="@(selectedIndex < 0 || busy)">Alt+D Delete</button>
        </div>
    </div>

    @if (!Database.IsConnected)
    {
        <div class="database-warning"><strong>PostgreSQL setup required</strong><p>@Database.Message</p></div>
    }
    else
    {
        <div class="database-ok">● PostgreSQL connected · Godowns are saved permanently</div>

        @if (showForm)
        {
            <KeyboardContextScope ContextId="godowns-form" RootElementId="godown-form-root"
                                  ContextType="KeyboardContextType.Form"
                                  Mode="@(editModel.Id == 0 ? KeyboardContextMode.Create : KeyboardContextMode.Alteration)"
                                  CanDelete="@(editModel.Id != 0 && !busy)" DeleteAsync="DeleteCurrent"
                                  InitialFocusTarget="godown-name-input" />
            <div id="godown-form-root" class="master-edit-form" data-enter-navigation="true" @onkeydown="HandleFormKeyDown" @onkeydown:stopPropagation="true">
                <div class="form-heading"><strong>@(editModel.Id == 0 ? "Create Godown" : "Alter Godown")</strong><span>Alt+S Save · Esc Cancel</span></div>
                <div class="master-form-grid">
                    <label>Godown Name <b>*</b><input id="godown-name-input" maxlength="200" @bind="editModel.Name" @bind:event="oninput" /></label>
                    <label>Alias<input maxlength="200" @bind="editModel.Alias" @bind:event="oninput" /></label>
                    <label>Address Line 1<input maxlength="250" @bind="editModel.AddressLine1" @bind:event="oninput" /></label>
                    <label>Address Line 2<input maxlength="250" @bind="editModel.AddressLine2" @bind:event="oninput" /></label>
                    <label>City<input maxlength="100" @bind="editModel.City" @bind:event="oninput" /></label>
                    <label>State<input maxlength="100" @bind="editModel.State" @bind:event="oninput" /></label>
                </div>
                <div class="form-actions">
                    <button type="button" class="primary-button" data-enter-save="true" @onclick="SaveAsync" disabled="@busy">Alt+S Save</button>
                    <button type="button" @onclick="CloseForm" disabled="@busy">Esc Cancel</button>
                </div>
            </div>
        }
        else
        {
            <div class="master-toolbar" @onkeydown="IgnoreToolbarKeyDown" @onkeydown:stopPropagation="true">
                <label><span>Search by Name, Alias or Address</span><input id="godown-search" data-tt-filter-input="true" placeholder="F4 Search" @bind="searchText" @bind:event="oninput" @onkeydown="HandleSearchKeyDown" /></label>
                <button type="button" @onclick="ApplySearch" disabled="@busy">Search</button>
                <button type="button" @onclick="ClearSearch" disabled="@busy">Clear</button>
                <span>@rows.Count godown(s)</span>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(message))
        {
            <p class="notice @(messageIsError ? "notice-error" : "notice-success")">@message</p>
        }

        @if (!showForm)
        {
            @if (loading)
            {
                <p class="muted">Loading Godowns…</p>
            }
            else
            {
                <div class="grid-wrap" id="godown-grid">
                    <table class="data-grid selectable-grid">
                        <thead><tr><th>Godown</th><th>Alias</th><th>Address</th><th>City</th><th>State</th></tr></thead>
                        <tbody>
                            @if (rows.Count == 0)
                            {
                                <tr><td colspan="5" class="empty-cell">No Godowns found.</td></tr>
                            }
                            else
                            {
                                @for (var i = 0; i < rows.Count; i++)
                                {
                                    var index = i;
                                    var row = rows[index];
                                    <tr @key="row.Id" id="godown-row-@row.Id" class="@(selectedIndex == index ? "selected-row" : null)" @onclick="() => SelectRow(index)" @ondblclick="OpenEdit">
                                        <td><strong>@row.Name</strong></td><td>@row.Alias</td><td>@Address(row)</td><td>@row.City</td><td>@row.State</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>
                <p class="master-help">↑/↓ Select · PgUp/PgDn Jump · Home/End · Enter Edit · F4 Search · Alt+C Create · Alt+D Delete · Esc Back</p>
            }
        }
    }
</div>

@code {
    private List<MasterListItem> rows = new();
    private MasterEditModel editModel = new();
    private int selectedIndex = -1;
    private bool loading = true;
    private bool busy;
    private bool showForm;
    private bool pendingNameFocus;
    private bool pendingSearchFocus;
    private bool pendingRowScroll;
    private string searchText = string.Empty;
    private string message = string.Empty;
    private bool messageIsError;
    private ElementReference pageRoot;

    protected override async Task OnInitializedAsync() => await LoadAsync();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender) await pageRoot.FocusAsync();
        if (pendingNameFocus)
        {
            pendingNameFocus = false;
            await JS.InvokeVoidAsync("texTrackFocusById", "godown-name-input");
        }
        if (pendingSearchFocus)
        {
            pendingSearchFocus = false;
            await JS.InvokeVoidAsync("texTrackFocusById", "godown-search");
        }
        if (pendingRowScroll && selectedIndex >= 0 && selectedIndex < rows.Count)
        {
            pendingRowScroll = false;
            await JS.InvokeVoidAsync("texTrackScrollRowIntoView", $"godown-row-{rows[selectedIndex].Id}", "godown-grid");
        }
    }

    private async Task LoadAsync(long? selectId = null)
    {
        if (!Database.IsConnected) { loading = false; return; }
        loading = true;
        try
        {
            rows = (await Repository.GetGodownListAsync(searchText)).ToList();
            if (rows.Count == 0) selectedIndex = -1;
            else if (selectId is not null)
            {
                selectedIndex = rows.FindIndex(x => x.Id == selectId.Value);
                if (selectedIndex < 0) selectedIndex = 0;
            }
            else if (selectedIndex < 0 || selectedIndex >= rows.Count) selectedIndex = 0;
            pendingRowScroll = selectedIndex >= 0;
        }
        catch (Exception exception) { ShowError(exception.GetBaseException().Message); }
        finally { loading = false; }
    }

    private void SelectRow(int index) { selectedIndex = index; message = string.Empty; pendingRowScroll = true; }

    private void OpenCreate()
    {
        if (busy || !Database.IsConnected) return;
        editModel = new MasterEditModel();
        showForm = true;
        message = string.Empty;
        pendingNameFocus = true;
    }

    private async Task OpenEdit()
    {
        if (selectedIndex < 0 || selectedIndex >= rows.Count || busy) return;
        var model = await Repository.GetGodownForEditAsync(rows[selectedIndex].Id);
        if (model is null) { ShowError("The selected Godown no longer exists."); await LoadAsync(); return; }
        editModel = model;
        showForm = true;
        message = string.Empty;
        pendingNameFocus = true;
    }

    private async Task SaveAsync()
    {
        if (busy) return;
        busy = true;
        try
        {
            var result = await Repository.SaveAsync(MasterKind.Godown, editModel);
            if (!result.Success) { ShowError(result.Message); pendingNameFocus = true; return; }
            showForm = false;
            ShowSuccess(result.Message);
            await LoadAsync(result.EntityId);
            await pageRoot.FocusAsync();
        }
        catch (Exception exception) { ShowError(exception.GetBaseException().Message); pendingNameFocus = true; }
        finally { busy = false; }
    }

    private Task DeleteSelected() => DeleteSelectedCore(false);
    private Task DeleteCurrent() => DeleteSelectedCore(true);

    private async Task DeleteSelectedCore(bool fromForm)
    {
        if (selectedIndex < 0 || selectedIndex >= rows.Count || busy) return;
        var selected = rows[selectedIndex];
        var confirmed = await JS.InvokeAsync<bool>("texTrackConfirmDelete", "Delete Godown?", $"Delete unused Godown '{selected.Name}'?", fromForm ? "godown-name-input" : $"godown-row-{selected.Id}");
        if (!confirmed) return;
        busy = true;
        try
        {
            var result = await Repository.DeleteAsync(MasterKind.Godown, selected.Id);
            if (!result.Success)
            {
                ShowError(result.Message);
                if (fromForm) pendingNameFocus = true; else pendingRowScroll = true;
                return;
            }
            showForm = false;
            editModel = new MasterEditModel();
            ShowSuccess(result.Message);
            await LoadAsync();
            if (selectedIndex >= rows.Count) selectedIndex = rows.Count - 1;
            pendingRowScroll = selectedIndex >= 0;
            await pageRoot.FocusAsync();
        }
        catch (Exception exception) { ShowError(exception.GetBaseException().Message); if (fromForm) pendingNameFocus = true; }
        finally { busy = false; }
    }

    private async Task CloseForm()
    {
        showForm = false;
        editModel = new MasterEditModel();
        message = string.Empty;
        pendingRowScroll = selectedIndex >= 0;
        await pageRoot.FocusAsync();
    }

    private async Task ApplySearch() { selectedIndex = -1; await LoadAsync(); await pageRoot.FocusAsync(); }
    private async Task ClearSearch() { searchText = string.Empty; selectedIndex = -1; await LoadAsync(); await pageRoot.FocusAsync(); }
    private static void IgnoreToolbarKeyDown(KeyboardEventArgs e) { }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ApplySearch();
        else if (e.Key == "Escape") await ClearSearch();
    }

    private async Task HandlePageKeyDown(KeyboardEventArgs e)
    {
        if (showForm) return;
        if (e.AltKey && e.Key.Equals("c", StringComparison.OrdinalIgnoreCase)) { OpenCreate(); return; }
        if (e.Key == "F4") { pendingSearchFocus = true; await InvokeAsync(StateHasChanged); return; }
        if (e.Key == "Escape") { Navigation.NavigateTo("/"); return; }
        if (rows.Count == 0) return;
        var changed = false;
        if (e.Key is "ArrowDown" or "Down") { selectedIndex = Math.Min(selectedIndex + 1, rows.Count - 1); changed = true; }
        else if (e.Key is "ArrowUp" or "Up") { selectedIndex = Math.Max(selectedIndex - 1, 0); changed = true; }
        else if (e.Key == "PageDown") { selectedIndex = Math.Min(selectedIndex + 10, rows.Count - 1); changed = true; }
        else if (e.Key == "PageUp") { selectedIndex = Math.Max(selectedIndex - 10, 0); changed = true; }
        else if (e.Key == "Home") { selectedIndex = 0; changed = true; }
        else if (e.Key == "End") { selectedIndex = rows.Count - 1; changed = true; }
        else if (e.Key == "Enter") await OpenEdit();
        if (changed) { pendingRowScroll = true; await InvokeAsync(StateHasChanged); }
    }

    private async Task HandleFormKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") await CloseForm();
        else if (e.AltKey && e.Key.Equals("s", StringComparison.OrdinalIgnoreCase)) await SaveAsync();
    }

    private void ShowSuccess(string value) { message = value; messageIsError = false; }
    private void ShowError(string value) { message = value; messageIsError = true; }
    private static string Address(MasterListItem row) => string.Join(", ", new[] { row.AddressLine1, row.AddressLine2 }.Where(x => !string.IsNullOrWhiteSpace(x)));
}
