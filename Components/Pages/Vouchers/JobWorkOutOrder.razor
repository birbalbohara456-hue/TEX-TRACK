    // Enter on a genuinely blank "Select Finished Good" field falls through to here via
    // data-enter-empty-action, since the field has nothing to select. Without explicitly
    // clearing activeLookupKey here, the dropdown could reappear after focus moves to the
    // Godown field: that field also opens its own lookup on focus, which triggers a Blazor
    // re-render, and since nothing had told the server this field's lookup was closed, the
    // @if block above would still render it - the earlier client-side-only hide (closeLookupOnBlur)
    // isn't enough on its own for this specific case, only clearing the state here is.
    private void DeclineBlankFinishedGoodItem(JobWorkFinishedGoodEditModel fg)
    {
        if (fg.StockItemId != 0 || !string.IsNullOrWhiteSpace(fg.StockItemText)) return;
        activeLookupKey = null;
