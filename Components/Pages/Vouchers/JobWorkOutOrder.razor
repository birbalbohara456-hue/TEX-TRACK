        ResolveFinishedGoodColourText(fg, true);
    }

    private void ResolveFinishedGoodColourText(JobWorkFinishedGoodEditModel fg, bool allowUniquePartial)
    {
        var item = FindFinishedGood(fg.StockItemId);
        if (item is null)
        {
            fg.ColourId = null;
            fg.SizeQuantities.Clear();
            return;
        }

        if (item.Colours.Count == 0)
        {
            fg.ColourId = null;
            fg.ColourText = string.Empty;
            RebuildSizeQuantities(fg, true);
            return;
        }

        var text = fg.ColourText.Trim();
        var colour = item.Colours.FirstOrDefault(x =>
            string.Equals(x.Name, text, StringComparison.OrdinalIgnoreCase));
        if (colour is null && allowUniquePartial && !string.IsNullOrWhiteSpace(text))
        {
            var candidates = item.Colours
                .Where(x => x.Name.Contains(text, StringComparison.OrdinalIgnoreCase))
                .ToList();
            if (candidates.Count == 1) colour = candidates[0];
        }
        if (colour is null && !allowUniquePartial) return;
        var changed = fg.ColourId != colour?.Id;
        fg.ColourId = colour?.Id;
        if (colour is not null) fg.ColourText = colour.Name;
        RebuildSizeQuantities(fg, !changed);
    }

    private void RebuildSizeQuantities(JobWorkFinishedGoodEditModel fg, bool preserve)
    {
        var item = FindFinishedGood(fg.StockItemId);
        if (item is null)
        {
            fg.SizeQuantities.Clear();
            return;
        }
        if (item.Colours.Count > 0 && fg.ColourId is null)
        {
            fg.SizeQuantities.Clear();
            return;
        }

        var oldByVariant = preserve
            ? fg.SizeQuantities.ToDictionary(x => x.StockItemVariantId, x => x.Quantity)
            : new Dictionary<long, decimal>();
        var allocations = new List<JobWorkSizeQuantityEditModel>();

        if (item.Sizes.Count == 0)
        {
            var variant = item.Variants.FirstOrDefault(x => x.ColourId == fg.ColourId && x.SizeId is null);
            if (variant is not null)
            {
                allocations.Add(new JobWorkSizeQuantityEditModel
                {
                    StockItemVariantId = variant.Id,
                    SizeId = null,
                    SizeName = "Quantity",
                    DisplayOrder = 0,
                    Quantity = oldByVariant.GetValueOrDefault(variant.Id)
                });
            }
        }
        else
        {
            foreach (var size in item.Sizes.OrderBy(x => x.DisplayOrder).ThenBy(x => x.Name))
            {
                var variant = item.Variants.FirstOrDefault(x => x.ColourId == fg.ColourId && x.SizeId == size.Id);
                if (variant is null) continue;
                allocations.Add(new JobWorkSizeQuantityEditModel
                {
                    StockItemVariantId = variant.Id,
                    SizeId = size.Id,
                    SizeName = size.Name,
                    DisplayOrder = size.DisplayOrder,
                    Quantity = oldByVariant.GetValueOrDefault(variant.Id)
                });
            }
        }
        fg.SizeQuantities = allocations;
    }

