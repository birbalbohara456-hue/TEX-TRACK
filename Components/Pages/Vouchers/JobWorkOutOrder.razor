    private void SelectVoucherType(JobWorkVoucherTypeLookup type)
    {
        if (editModel.Id != 0) return;
        var previousNumber = editModel.VoucherNumber;
        editModel.VoucherTypeId = type.Id;
        editModel.VoucherTypeText = type.Name;
        editModel.SequenceNumber = type.NextSequence;
        editModel.VoucherNumber = type.NextVoucherNumber;
        if (string.IsNullOrWhiteSpace(editModel.ReferenceNumber) || editModel.ReferenceNumber == previousNumber)
            editModel.ReferenceNumber = type.NextVoucherNumber;
        activeLookupKey = null;
        pendingFocusId = IsManualVoucherNumber ? "jwo-voucher-number" : "jwo-batch-input";
    }

    private void ResolveVoucherTypeText()
    {
        var type = lookups.VoucherTypes.FirstOrDefault(x =>
            x.Id == editModel.VoucherTypeId ||
            string.Equals(x.Name, editModel.VoucherTypeText.Trim(), StringComparison.OrdinalIgnoreCase));
        if (type is null)
        {
            editModel.VoucherTypeId = 0;
            return;
        }
        editModel.VoucherTypeId = type.Id;
        editModel.VoucherTypeText = type.Name;
    }

