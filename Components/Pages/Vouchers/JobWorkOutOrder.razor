    // 🔴 FIX: Force Random Material Typing to show Error and Wipe Box
    private void ResolveComponentText(JobWorkComponentEditModel component, bool allowUniquePartial)
    {
        var text = component.StockItemText.Trim();
        var item = lookups.Components.FirstOrDefault(x =>
            string.Equals(x.Name, text, StringComparison.OrdinalIgnoreCase));
        if (item is null && allowUniquePartial && !string.IsNullOrWhiteSpace(text))
        {
            var candidates = lookups.Components
                .Where(x => x.Name.Contains(text, StringComparison.OrdinalIgnoreCase))
                .ToList();
            if (candidates.Count == 1) item = candidates[0];
        }

        if (item is null && !allowUniquePartial) return;
        var previousItemId = component.StockItemId;
        component.StockItemId = item?.Id ?? 0;
        component.UqcId = item?.UqcId ?? 0;
        component.UqcShortName = item?.UqcShortName ?? string.Empty;
        if (item is not null)
        {
            component.StockItemText = item.Name;
            if (previousItemId != item.Id || component.XmlRate <= 0)
            {
                component.XmlRate = item.LatestComponentRate;
                componentRateText[component.ClientKey] = FormatInputRate(component.XmlRate);
            }
            component.XmlAmount = decimal.Round(component.RequiredQuantity * component.XmlRate, 4, MidpointRounding.AwayFromZero);
        }
    }

    private void ComponentQuantityChanged(JobWorkComponentEditModel component, ChangeEventArgs e)
    {
        component.RequiredQuantity = decimal.TryParse(e.Value?.ToString(), NumberStyles.Number, CultureInfo.InvariantCulture, out var quantity)
            ? quantity
            : 0;
        component.XmlAmount = decimal.Round(component.RequiredQuantity * component.XmlRate, 4, MidpointRounding.AwayFromZero);
    }

    private string GetComponentRateText(JobWorkComponentEditModel component)
    {
        if (componentRateText.TryGetValue(component.ClientKey, out var text)) return text;
        text = FormatInputRate(component.XmlRate);
        componentRateText[component.ClientKey] = text;
        return text;
    }

    private void ComponentRateChanged(JobWorkComponentEditModel component, ChangeEventArgs e)
    {
        var text = e.Value?.ToString() ?? string.Empty;
        componentRateText[component.ClientKey] = text;
        var normalized = text.Trim().Replace(',', '.');
        if (decimal.TryParse(normalized, NumberStyles.AllowDecimalPoint | NumberStyles.AllowLeadingSign, CultureInfo.InvariantCulture, out var rate) && rate >= 0)
        {
            component.XmlRate = rate;
            component.XmlAmount = decimal.Round(component.RequiredQuantity * component.XmlRate, 4, MidpointRounding.AwayFromZero);
        }
    }

    private void NormalizeComponentRateText(JobWorkComponentEditModel component)
    {
        if (!componentRateText.TryGetValue(component.ClientKey, out var text))
            text = FormatInputRate(component.XmlRate);

        var normalized = text.Trim().Replace(',', '.');
        if (!decimal.TryParse(normalized, NumberStyles.AllowDecimalPoint | NumberStyles.AllowLeadingSign, CultureInfo.InvariantCulture, out var rate) || rate < 0)
            rate = component.XmlRate;

        component.XmlRate = Math.Max(0, rate);
        component.XmlAmount = decimal.Round(component.RequiredQuantity * component.XmlRate, 4, MidpointRounding.AwayFromZero);
        componentRateText[component.ClientKey] = FormatInputRate(component.XmlRate);
    }

    private void OpenComponentAllocation(JobWorkFinishedGoodEditModel fg)
    {
        if (fg.StockItemId <= 0)
        {
            ShowError("Select a Finished Good before entering components.");
            pendingFocusId = $"jwo-fg-item-{fg.ClientKey}";
            return;
        }

        activeComponentFg = fg;
        componentPopupMessage = string.Empty;
        var blank = fg.Components.LastOrDefault(IsBlankComponent);
        if (blank is null)
        {
            blank = new JobWorkComponentEditModel();
            fg.Components.Add(blank);
        }
        pendingFocusId = $"jwo-component-{blank.ClientKey}";
    }

    // Manual allocation (no BOM) builds its production stages by hand, one at a time, instead
    // of BomChanged auto-generating them from a template. Same underlying JobWorkBomStageEditModel
    // as a BOM-driven stage - just SourceBomId left null - so it saves through the identical
    // path and is automatically covered by Rate Variance/Job Worker Control like any other stage.
    private void AddManualStage(JobWorkFinishedGoodEditModel group)
    {
        var item = FindFinishedGood(group.StockItemId);
        var stage = new JobWorkBomStageEditModel
        {
            StageNumber = group.BomStages.Count + 1,
            StageLevel = 0,
            StagePath = (group.BomStages.Count + 1).ToString(),
            StageName = group.StockItemText,
            OutputStockItemId = group.StockItemId,
            OutputStockItemText = group.StockItemText,
            OutputUqcId = item?.UqcId ?? 0,
            OutputUqcShortName = item?.UqcShortName ?? group.UqcShortName,
            OutputQuantity = group.TotalQuantity,
            IsFinalStage = true,
            ExpectedCompletionDate = editModel.DueDate ?? editModel.VoucherDate
        };
        group.BomStages.Add(stage);
        pendingFocusId = $"jwo-stage-worker-{stage.ClientKey}";
    }

    private void RemoveManualStage(JobWorkFinishedGoodEditModel group, JobWorkBomStageEditModel stage)
    {
        if (stage.SourceBomId is not null) return;
        var stages = group.BomStages.OrderBy(s => s.StageNumber).ToList();
        var index = stages.IndexOf(stage);
        group.BomStages.Remove(stage);
        var renumbered = group.BomStages.OrderBy(s => s.StageNumber).ToList();
        for (var i = 0; i < renumbered.Count; i++)
        {
            renumbered[i].StageNumber = i + 1;
            renumbered[i].StagePath = (i + 1).ToString();
        }

        if (renumbered.Count == 0)
        {
            // A manual finished good can't be saved with zero stages (nothing would flow into
            // Rate Variance / Job Worker Control for it), so removing the only stage puts a
            // fresh blank one back rather than leaving the finished good stage-less.
            AddManualStage(group);
            return;
        }

        var adjacent = renumbered[Math.Min(index, renumbered.Count - 1)];
        pendingFocusId = $"jwo-stage-worker-{adjacent.ClientKey}";
    }

    // Mirrors the blank-decline convention used for colours (FinishColourEntry) and components
    // (AdvanceComponentItem/IsBlankComponent): leaving a manual stage's Job Worker field blank
    // and pressing Enter means "I don't want this stage" - discard it and move straight to
    // Components, rather than making the user tab through every remaining blank field first or
    // land back on "+ Stage". Only reachable for a stage with no job worker typed yet, so this
    // never discards a stage the user has actually started filling in.
    private void DeclineBlankStage(JobWorkFinishedGoodEditModel group, JobWorkBomStageEditModel stage)
    {
        if (stage.SourceBomId is not null) return;
        if (stage.AssignedJobWorkerId is not null || !string.IsNullOrWhiteSpace(stage.AssignedJobWorkerText)) return;

        group.BomStages.Remove(stage);
        var renumbered = group.BomStages.OrderBy(s => s.StageNumber).ToList();
        for (var i = 0; i < renumbered.Count; i++)
        {
            renumbered[i].StageNumber = i + 1;
            renumbered[i].StagePath = (i + 1).ToString();
        }

        if (renumbered.Count == 0)
        {
            // Declining the only stage still leaves the finished good needing at least one
            // (see RemoveManualStage) - put a fresh blank one back instead of opening Components
            // with no process assigned at all.
            AddManualStage(group);
            return;
        }

        OpenComponentAllocation(group);
    }

    // Reaching the end of a stage row's fields (Expected Rate, the last one): move on to the
    // next stage if there is one. Otherwise, for manual allocation the stage list is open-ended
    // (unlike a BOM template's fixed stage count), so land on "+ Stage" instead of jumping
    // straight into Components - Enter/Space there adds another stage, or Tab reaches
    // "Enter Components" to move on. A BOM-driven finished good has no "+ Stage" affordance
    // (its stages come from the template), so it goes straight to Components as before.
    private void CompleteStageLine(JobWorkFinishedGoodEditModel group, JobWorkBomStageEditModel stage)
    {
        var ordered = group.BomStages.OrderBy(s => s.StageNumber).ToList();
        var index = ordered.IndexOf(stage);
        var next = index >= 0 && index < ordered.Count - 1 ? ordered[index + 1] : null;
        if (next is not null)
        {
            pendingFocusId = $"jwo-stage-worker-{next.ClientKey}";
            return;
        }

        if (group.BillOfMaterialId is null)
        {
            pendingFocusId = $"jwo-add-stage-{group.ClientKey}";
            return;
        }

        OpenComponentAllocation(group);
    }

    private void AdvanceComponentItem(JobWorkComponentEditModel component)
    {
        if (activeComponentFg is null) return;

        ResolveComponentText(component, true);
        if (IsBlankComponent(component))
        {
            CloseComponentAllocation();
            return;
        }

        // 🔴 FIX: Show error AND WIPE BAD TEXT when typing random material
        if (component.StockItemId <= 0)
        {
            componentPopupMessage = "Select a valid Component Stock Item.";
            component.StockItemText = string.Empty; // Wipe bad text
            pendingFocusId = $"jwo-component-{component.ClientKey}";
            return;
        }

        componentPopupMessage = string.Empty;
        activeLookupKey = null;
        pendingFocusId = $"jwo-component-godown-{component.ClientKey}";
    }

    private void FocusComponentQuantity(JobWorkComponentEditModel component)
    {
        if (activeComponentFg is null) return;

        ResolveComponentGodown(component);
        if (component.ComponentGodownId is null)
        {
            componentPopupMessage = "Select a valid Component Godown.";
            pendingFocusId = $"jwo-component-godown-{component.ClientKey}";
            return;
        }

        componentPopupMessage = string.Empty;
        activeLookupKey = null;
        pendingFocusId = $"jwo-component-qty-{component.ClientKey}";
    }

    private void FocusComponentRate(JobWorkComponentEditModel component)
    {
        if (component.RequiredQuantity <= 0)
        {
            componentPopupMessage = "Required Quantity must be greater than zero.";
            pendingFocusId = $"jwo-component-qty-{component.ClientKey}";
            return;
        }

        componentPopupMessage = string.Empty;
        if (!componentRateText.ContainsKey(component.ClientKey))
            componentRateText[component.ClientKey] = FormatInputRate(component.XmlRate);
        component.XmlAmount = decimal.Round(component.RequiredQuantity * component.XmlRate, 4, MidpointRounding.AwayFromZero);
        pendingFocusId = $"jwo-component-rate-{component.ClientKey}";
    }

    private void CompleteComponentLine(JobWorkComponentEditModel component)
    {
        if (activeComponentFg is null) return;

        ResolveComponentText(component, true);
        if (IsBlankComponent(component))
        {
            CloseComponentAllocation();
            return;
        }

        if (component.StockItemId <= 0)
        {
            componentPopupMessage = "Select a valid Component Stock Item.";
            component.StockItemText = string.Empty; // Wipe bad text
            pendingFocusId = $"jwo-component-{component.ClientKey}";
            return;
        }

        ResolveComponentGodown(component);
        if (component.ComponentGodownId is null)
        {
            componentPopupMessage = "Select a valid Component Godown.";
            pendingFocusId = $"jwo-component-godown-{component.ClientKey}";
            return;
        }

        if (component.RequiredQuantity <= 0)
        {
            componentPopupMessage = "Required Quantity must be greater than zero.";
            pendingFocusId = $"jwo-component-qty-{component.ClientKey}";
            return;
        }

        NormalizeComponentRateText(component);
        if (component.XmlRate < 0)
        {
            componentPopupMessage = "Rate cannot be negative.";
            pendingFocusId = $"jwo-component-rate-{component.ClientKey}";
            return;
        }
        component.XmlAmount = decimal.Round(component.RequiredQuantity * component.XmlRate, 4, MidpointRounding.AwayFromZero);

        var duplicate = activeComponentFg.Components.Any(x =>
            !ReferenceEquals(x, component) &&
            x.StockItemId > 0 &&
            x.StockItemId == component.StockItemId);
        if (duplicate)
        {
            componentPopupMessage = $"Component '{component.StockItemText}' is already entered for this Finished Good.";
            pendingFocusId = $"jwo-component-{component.ClientKey}";
            return;
        }

        componentPopupMessage = string.Empty;
        var next = new JobWorkComponentEditModel();
        activeComponentFg.Components.Add(next);
        pendingFocusId = $"jwo-component-{next.ClientKey}";
    }

    private void SkipToNarration()
    {
        var last = editModel.FinishedGoods.LastOrDefault();
        if (last != null && last.StockItemId <= 0 && string.IsNullOrWhiteSpace(last.StockItemText) && editModel.FinishedGoods.Count > 1)
        {
            editModel.FinishedGoods.Remove(last);
        }
        pendingFocusId = "jwo-narration-input";
    }

    private void ClearBlankComponentRows(JobWorkFinishedGoodEditModel fg)
    {
        var removedKeys = fg.Components.Where(IsBlankComponent).Select(x => x.ClientKey).ToList();
        fg.Components.RemoveAll(IsBlankComponent);
        foreach (var key in removedKeys) componentRateText.Remove(key);
    }

    // Escape from the Components section steps back one level only - to the still-open
    // Process/BOM view of the same Material Allocation popup - without advancing to
    // another finished good. This is deliberately NOT the same as CloseComponentAllocation
    // below: that one means "genuinely done with this finished good," this one means
    // "let me look at Process again."
    private void StepBackFromComponents()
    {
        if (activeComponentFg is null) return;
        var owner = activeComponentFg;
        ClearBlankComponentRows(owner);
        activeComponentFg = null;
        componentPopupMessage = string.Empty;
        pendingFocusId = materialAllocationGroup is { } group ? $"jwo-open-components-{group.ClientKey}" : null;
    }

    // Genuinely finished entering components for this finished good (triggered by pressing
    // Enter on a blank trailing component row): closes the whole Material Allocation popup
    // and advances to the next finished good, a fresh blank one, or the Save button.
    private void CloseComponentAllocation()
    {
        if (activeComponentFg is null) return;
        var closedFg = activeComponentFg;
        ClearBlankComponentRows(closedFg);
        activeComponentFg = null;
        componentPopupMessage = string.Empty;
        materialAllocationGroup = null;

        var currentIndex = editModel.FinishedGoods.IndexOf(closedFg);
        if (currentIndex >= 0 && currentIndex == editModel.FinishedGoods.Count - 1)
        {
            var newFg = new JobWorkFinishedGoodEditModel();
            editModel.FinishedGoods.Add(newFg);
            pendingFocusId = $"jwo-fg-item-{newFg.ClientKey}";
        }
        else if (currentIndex >= 0 && currentIndex < editModel.FinishedGoods.Count - 1)
        {
            var nextFg = editModel.FinishedGoods[currentIndex + 1];
            pendingFocusId = $"jwo-fg-item-{nextFg.ClientKey}";
        }
        else
        {
            pendingFocusId = "jwo-save-button";
        }
    }

    // Escape steps back one level at a time: out of Components (back to BOM/Process,
    // still inside the same popup) first, then out of the popup entirely - mirroring
    // how Escape already works for nested menus elsewhere in this app.
    private void HandleMaterialAllocationKeyDown(KeyboardEventArgs e)
    {
        if (e.Key != "Escape") return;
        if (activeComponentFg is not null) StepBackFromComponents();
        else CloseMaterialAllocation();
    }

    private static bool IsBlankComponent(JobWorkComponentEditModel component)
        => component.StockItemId <= 0 &&
           string.IsNullOrWhiteSpace(component.StockItemText) &&
           string.IsNullOrWhiteSpace(component.ComponentGodownText) &&
           component.RequiredQuantity == 0 &&
           component.XmlRate == 0;

    private void RemoveBlankComponentRows()
    {
        foreach (var fg in editModel.FinishedGoods)
        {
            fg.Components.RemoveAll(IsBlankComponent);
        }
    }

    private void ResolveAllTypedLookups()
    {
        ResolveVoucherTypeText();
        ResolveJobWorkerText(true);
        foreach (var fg in editModel.FinishedGoods)
        {
            ResolveFinishedGoodText(fg, true);
            ResolveFinishedGoodColourText(fg, true);
            ResolveFinishedGoodGodowns(fg);
            foreach (var component in fg.Components) { ResolveComponentText(component, true); ResolveComponentGodown(component); }
        }
    }

    private static string DateInputValue(DateOnly value)
        => value.ToString("yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture);

    private static string FormatInputRate(decimal rate)
        => rate.ToString("0.00", CultureInfo.InvariantCulture);

    private static string FormatInputQuantity(decimal quantity)
        => quantity == 0
            ? string.Empty
            : quantity.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture);

