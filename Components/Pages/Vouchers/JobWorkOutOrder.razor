        activeLookupKey = null;
        var firstAllocation = fg.SizeQuantities.OrderBy(x => x.DisplayOrder).ThenBy(x => x.SizeName).FirstOrDefault();
        pendingFocusId = firstAllocation is not null
            ? $"jwo-fg-qty-{fg.ClientKey}-{firstAllocation.StockItemVariantId}"
            : null;
        if (pendingFocusId is null) FocusFirstProcess(fg);
    }
