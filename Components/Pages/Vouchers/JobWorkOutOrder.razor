    private IEnumerable<JobWorkFinishedGoodEditModel> GetGroupLines(JobWorkFinishedGoodEditModel fg)
        => editModel.FinishedGoods.Where(x => x.DesignGroupKey == fg.DesignGroupKey);

    private JobWorkFinishedGoodEditModel GetGroupOwner(JobWorkFinishedGoodEditModel fg)
        => GetGroupLines(fg).FirstOrDefault() ?? fg;

    private bool IsGroupLast(JobWorkFinishedGoodEditModel fg)
        => ReferenceEquals(GetGroupLines(fg).LastOrDefault(), fg);

    private decimal GroupTotal(JobWorkFinishedGoodEditModel fg)
        => GetGroupLines(fg).Sum(x => x.TotalQuantity);

    private int GetGroupOrdinal(JobWorkFinishedGoodEditModel fg)
    {
        var key = string.IsNullOrWhiteSpace(fg.DesignGroupKey) ? fg.ClientKey : fg.DesignGroupKey;
        return editModel.FinishedGoods
            .TakeWhile(x => !ReferenceEquals(x, fg))
            .Select(x => string.IsNullOrWhiteSpace(x.DesignGroupKey) ? x.ClientKey : x.DesignGroupKey)
            .Distinct(StringComparer.Ordinal)
            .Count() + 1;
    }

    private bool HasUnusedColours(JobWorkFinishedGoodEditModel fg)
    {
        var item = FindFinishedGood(fg.StockItemId);
        if (item is null || item.Colours.Count == 0) return false;
        var used = GetGroupLines(fg).Where(x => x.ColourId.HasValue).Select(x => x.ColourId!.Value).ToHashSet();
        return item.Colours.Any(x => !used.Contains(x.Id));
    }

    private void AddColourLine(JobWorkFinishedGoodEditModel fg)
    {
        var owner = GetGroupOwner(fg);
        if (!HasUnusedColours(owner))
        {
            FocusFirstProcess(owner);
            return;
        }

        var line = new JobWorkFinishedGoodEditModel
        {
            DesignGroupKey = owner.DesignGroupKey,
            StockItemId = owner.StockItemId,
            StockItemText = owner.StockItemText,
            UqcShortName = owner.UqcShortName,
            FinishedGoodsGodownId = owner.FinishedGoodsGodownId,
            FinishedGoodsGodownText = owner.FinishedGoodsGodownText,
            DestinationGodownId = owner.DestinationGodownId,
            DestinationGodownText = owner.DestinationGodownText
        };

        var lastIndex = editModel.FinishedGoods.FindLastIndex(x => x.DesignGroupKey == owner.DesignGroupKey);
        editModel.FinishedGoods.Insert(lastIndex + 1, line);
        activeLookupKey = null;
        pendingFocusId = $"jwo-fg-colour-{line.ClientKey}";
    }

    private void FinishColourEntry(JobWorkFinishedGoodEditModel fg)
    {
        var owner = GetGroupOwner(fg);
        if (!ReferenceEquals(owner, fg) && fg.ColourId is null && string.IsNullOrWhiteSpace(fg.ColourText))
        {
            editModel.FinishedGoods.Remove(fg);
            FocusFirstProcess(owner);
            return;
        }

        if (fg.ColourId is not null && HasUnusedColours(fg)) AddColourLine(fg);
        else FocusFirstProcess(owner);
    }


    private void RemoveFinishedGood(int index)
    {
        if (index < 0 || index >= editModel.FinishedGoods.Count) return;
        var removed = editModel.FinishedGoods[index];
        var owner = GetGroupOwner(removed);
        var replacement = ReferenceEquals(owner, removed)
            ? GetGroupLines(removed).Skip(1).FirstOrDefault()
            : null;

        if (replacement is not null)
        {
            replacement.StockItemId = owner.StockItemId;
            replacement.StockItemText = owner.StockItemText;
            replacement.UqcShortName = owner.UqcShortName;
            replacement.FinishedGoodsGodownId = owner.FinishedGoodsGodownId;
            replacement.FinishedGoodsGodownText = owner.FinishedGoodsGodownText;
            replacement.DestinationGodownId = owner.DestinationGodownId;
            replacement.DestinationGodownText = owner.DestinationGodownText;
            replacement.BillOfMaterialId = owner.BillOfMaterialId;
            replacement.BillOfMaterialText = owner.BillOfMaterialText;
            replacement.BomStages = owner.BomStages;
            replacement.Components = owner.Components;
        }
        editModel.FinishedGoods.RemoveAt(index);
        if (editModel.FinishedGoods.Count == 0)
        {
            AddFinishedGood();
            return;
        }

        var adjacent = editModel.FinishedGoods[Math.Min(index, editModel.FinishedGoods.Count - 1)];
        pendingFocusId = ReferenceEquals(GetGroupOwner(adjacent), adjacent)
            ? $"jwo-fg-item-{adjacent.ClientKey}"
            : $"jwo-fg-colour-{adjacent.ClientKey}";
    }

    private void AddComponent(JobWorkFinishedGoodEditModel fg)
        => OpenComponentAllocation(fg);

    private void RemoveComponent(JobWorkFinishedGoodEditModel fg, int index)
    {
        if (index < 0 || index >= fg.Components.Count) return;
        fg.Components.RemoveAt(index);

        if (ReferenceEquals(activeComponentFg, fg))
        {
            var blank = fg.Components.LastOrDefault(IsBlankComponent);
            if (blank is null)
            {
                blank = new JobWorkComponentEditModel();
                fg.Components.Add(blank);
            }
            pendingFocusId = $"jwo-component-{blank.ClientKey}";
        }
    }
    
