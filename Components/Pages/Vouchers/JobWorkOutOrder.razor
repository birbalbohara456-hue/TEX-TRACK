        await pageRoot.FocusAsync();
    }

    private static void IgnoreToolbarKeyDown(KeyboardEventArgs e) { }

    private async Task HandleSearchKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await ApplySearch();
        else if (e.Key == "Escape") await ClearSearch();
    }

    private async Task HandlePageKeyDown(KeyboardEventArgs e)
    {
        if (showExitModal || showDeleteModal || showCancelVoucherModal) return;
        if (showForm)
        {
            return;
        }
        if (e.AltKey && e.Key.Equals("c", StringComparison.OrdinalIgnoreCase))
        {
            await OpenCreate();
            return;
        }
        if (e.Key == "F4")
        {
            pendingSearchFocus = true;
            await InvokeAsync(StateHasChanged);
            return;
        }
        if (rows.Count == 0) return;

        var changed = false;
        if (e.Key is "ArrowDown" or "Down") { selectedIndex = Math.Min(selectedIndex + 1, rows.Count - 1); changed = true; }
        else if (e.Key is "ArrowUp" or "Up") { selectedIndex = Math.Max(selectedIndex - 1, 0); changed = true; }
        else if (e.Key == "PageDown") { selectedIndex = Math.Min(selectedIndex + 10, rows.Count - 1); changed = true; }
        else if (e.Key == "PageUp") { selectedIndex = Math.Max(selectedIndex - 10, 0); changed = true; }
        else if (e.Key == "Home") { selectedIndex = 0; changed = true; }
        else if (e.Key == "End") { selectedIndex = rows.Count - 1; changed = true; }
        else if (e.Key == "Enter") { await OpenEdit(); }

        if (changed)
        {
            pendingRowScroll = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private void ExitList() => Navigation.NavigateTo("/");

    private async Task HandleFormKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            await RequestCloseForm();
        }
        else if (e.AltKey && e.Key.Equals("a", StringComparison.OrdinalIgnoreCase)) await SaveAsync();
    }

    private string GetValidationFocusId(string validationMessage)
    {
        if (validationMessage.Contains("Voucher Date", StringComparison.OrdinalIgnoreCase)) return "jwo-date-input";
        if (validationMessage.Contains("Expected Completion", StringComparison.OrdinalIgnoreCase))
        {
            var stage = editModel.FinishedGoods.SelectMany(x => x.BomStages)
                .FirstOrDefault(x => x.ExpectedCompletionDate is null || x.ExpectedCompletionDate < editModel.VoucherDate);
            return stage is null ? "jwo-save-button" : $"jwo-stage-expected-{stage.ClientKey}";
        }
        if (validationMessage.Contains("Batch", StringComparison.OrdinalIgnoreCase)) return "jwo-batch-input";
        if (validationMessage.Contains("Job Worker", StringComparison.OrdinalIgnoreCase))
        {
            var stage = editModel.FinishedGoods.SelectMany(x => x.BomStages).FirstOrDefault(x => x.AssignedJobWorkerId is null);
            return stage is null ? "jwo-save-button" : $"jwo-stage-worker-{stage.ClientKey}";
        }
        if (validationMessage.Contains("Voucher Number", StringComparison.OrdinalIgnoreCase)) return "jwo-voucher-number";

        var fg = editModel.FinishedGoods.FirstOrDefault();
        if (fg is null) return "jwo-save-button";
        if (validationMessage.Contains("Colour", StringComparison.OrdinalIgnoreCase)) return $"jwo-fg-colour-{fg.ClientKey}";
        if (validationMessage.Contains("Godown", StringComparison.OrdinalIgnoreCase) && validationMessage.Contains("Component", StringComparison.OrdinalIgnoreCase))
            return fg.Components.Count > 0 ? $"jwo-component-godown-{fg.Components[0].ClientKey}" : $"jwo-fg-godown-{fg.ClientKey}";
        if (validationMessage.Contains("Godown", StringComparison.OrdinalIgnoreCase)) return $"jwo-fg-godown-{fg.ClientKey}";
        if (validationMessage.Contains("Process", StringComparison.OrdinalIgnoreCase))
        {
            var stage = fg.BomStages.OrderBy(s => s.StageNumber).FirstOrDefault(s => s.ProcessId is null or <= 0);
            return stage is null ? $"jwo-fg-item-{fg.ClientKey}" : $"jwo-stage-worker-{stage.ClientKey}";
        }
        if (validationMessage.Contains("Component", StringComparison.OrdinalIgnoreCase))
            return fg.Components.Count > 0 ? $"jwo-component-{fg.Components[0].ClientKey}" : $"jwo-fg-item-{fg.ClientKey}";
        if (validationMessage.Contains("Quantity", StringComparison.OrdinalIgnoreCase) || validationMessage.Contains("variant", StringComparison.OrdinalIgnoreCase))
        {
            var allocation = fg.SizeQuantities.OrderBy(x => x.DisplayOrder).ThenBy(x => x.SizeName).FirstOrDefault();
            if (allocation is not null) return $"jwo-fg-qty-{fg.ClientKey}-{allocation.StockItemVariantId}";
        }
        if (validationMessage.Contains("Finished Good", StringComparison.OrdinalIgnoreCase)) return $"jwo-fg-item-{fg.ClientKey}";
        return "jwo-save-button";
    }

    private static void IgnoreMouseDown(MouseEventArgs e) { }
    private static long ParseRequiredId(object? value) => long.TryParse(value?.ToString(), out var id) ? id : 0;
    private static long? ParseOptionalId(object? value) => long.TryParse(value?.ToString(), out var id) ? id : null;
    private void ShowSuccess(string text) { message = text; messageIsError = false; }
    private void ShowError(string text) { message = text; messageIsError = true; }
}
