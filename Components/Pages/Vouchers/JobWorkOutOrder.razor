    private void ResolveFinishedGoodGodowns(JobWorkFinishedGoodEditModel fg)
    {
        var source = lookups.Godowns.FirstOrDefault(x => string.Equals(x.Name, fg.FinishedGoodsGodownText.Trim(), StringComparison.OrdinalIgnoreCase));
        var destination = lookups.Godowns.FirstOrDefault(x => string.Equals(x.Name, fg.DestinationGodownText.Trim(), StringComparison.OrdinalIgnoreCase));
        fg.FinishedGoodsGodownId = source?.Id;
        fg.DestinationGodownId = destination?.Id ?? source?.Id;
        if (destination is null && source is not null) fg.DestinationGodownText = source.Name;
    }

    private void ResolveComponentGodown(JobWorkComponentEditModel component)
    {
        var godown = lookups.Godowns.FirstOrDefault(x => string.Equals(x.Name, component.ComponentGodownText.Trim(), StringComparison.OrdinalIgnoreCase));
        component.ComponentGodownId = godown?.Id;
        if (godown is not null) component.ComponentGodownText = godown.Name;
    }

