    private void FinishedGoodItemTextCommitted(JobWorkFinishedGoodEditModel fg, ChangeEventArgs e)
    {
        fg.StockItemText = e.Value?.ToString() ?? string.Empty;
        ResolveFinishedGoodText(fg, true);
    }

    private void ResolveFinishedGoodText(JobWorkFinishedGoodEditModel fg, bool allowUniquePartial)
    {
        var text = fg.StockItemText.Trim();
        var item = lookups.FinishedGoods.FirstOrDefault(x =>
            string.Equals(x.Name, text, StringComparison.OrdinalIgnoreCase));
        if (item is null && allowUniquePartial && !string.IsNullOrWhiteSpace(text))
        {
            var candidates = lookups.FinishedGoods
                .Where(x => x.Name.Contains(text, StringComparison.OrdinalIgnoreCase))
                .ToList();
            if (candidates.Count == 1) item = candidates[0];
        }

        if (item is null)
        {
            if (!allowUniquePartial) return;
            if (fg.StockItemId != 0)
            {
                fg.StockItemId = 0;
                fg.ColourId = null;
                fg.ColourText = string.Empty;
                fg.UqcShortName = string.Empty;
                fg.SizeQuantities.Clear();
            }
            return;
        }

        var itemChanged = fg.StockItemId != item.Id;
        fg.StockItemId = item.Id;
        fg.StockItemText = item.Name;
        fg.UqcShortName = item.UqcShortName;

        if (itemChanged)
        {
            fg.ColourId = null;
            fg.ColourText = string.Empty;
            fg.SizeQuantities.Clear();
        }

        if (item.Colours.Count == 1)
        {
            fg.ColourId = item.Colours[0].Id;
            fg.ColourText = item.Colours[0].Name;
        }

        RebuildSizeQuantities(fg, !itemChanged);
    }

