        var worker = lookups.JobWorkers.FirstOrDefault(x =>
            string.Equals(JobWorkerDisplay(x), text, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(x.Name, text, StringComparison.OrdinalIgnoreCase));

        if (worker is null && allowUniquePartial && !string.IsNullOrWhiteSpace(text))
        {
            var candidates = lookups.JobWorkers
                .Where(x => JobWorkerDisplay(x).Contains(text, StringComparison.OrdinalIgnoreCase) ||
                            x.Name.Contains(text, StringComparison.OrdinalIgnoreCase))
                .ToList();
            if (candidates.Count == 1) worker = candidates[0];
        }

        if (worker is null && !allowUniquePartial) return;
        editModel.JobWorkerLedgerId = worker?.Id;
        if (worker is not null) editModel.JobWorkerText = JobWorkerFieldText(worker);
