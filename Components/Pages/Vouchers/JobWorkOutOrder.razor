    // Godown sits between item and colour in both the row layout and the keyboard chain:
    // Item -> Godown -> Colour -> Size -> Process. Used after Godown resolves, whether by
    // picking a lookup match or by typing a value and pressing Enter with no dropdown open.
    private void FocusColourOrSize(JobWorkFinishedGoodEditModel fg)
    {
        var item = FindFinishedGood(fg.StockItemId);
        if (item is not null && item.Colours.Count > 0)
        {
            pendingFocusId = $"jwo-fg-colour-{fg.ClientKey}";
            return;
        }

        FocusFirstSizeThenProcess(fg);
    }

    private void FocusFirstSizeThenProcess(JobWorkFinishedGoodEditModel fg)
    {
        var firstAllocation = fg.SizeQuantities.OrderBy(x => x.DisplayOrder).ThenBy(x => x.SizeName).FirstOrDefault();
        if (firstAllocation is not null) pendingFocusId = $"jwo-fg-qty-{fg.ClientKey}-{firstAllocation.StockItemVariantId}";
        else FocusFirstProcess(fg);
    }

