    private void OpenMaterialAllocation(JobWorkFinishedGoodEditModel groupOwner)
    {
        materialAllocationReturnFocusId = $"jwo-fg-item-{groupOwner.ClientKey}";
        materialAllocationGroup = groupOwner;
    }

    private void CloseMaterialAllocation()
    {
        pendingFocusId = materialAllocationReturnFocusId ?? "jwo-page-root";
        materialAllocationReturnFocusId = null;
        materialAllocationGroup = null;
    }

    // Where the keyboard chain naturally was right before the popup opened, so Escape (or the
    // "Esc Close" button) can jump back there instead of leaving focus nowhere traceable. The
    // chain always runs Item -> Godown -> Colour -> Size -> Process, so whatever the group's
    // data has furthest along that sequence is exactly where the user was.
    private string ComputeMaterialAllocationReturnFocusId(JobWorkFinishedGoodEditModel owner)
    {
        var lastAllocation = owner.SizeQuantities.OrderBy(x => x.DisplayOrder).ThenBy(x => x.SizeName).LastOrDefault();
        if (lastAllocation is not null) return $"jwo-fg-qty-{owner.ClientKey}-{lastAllocation.StockItemVariantId}";
        var item = FindFinishedGood(owner.StockItemId);
        if (item is not null && item.Colours.Count > 0) return $"jwo-fg-colour-{owner.ClientKey}";
        return $"jwo-fg-godown-{owner.ClientKey}";
    }

    private void FocusFirstProcess(JobWorkFinishedGoodEditModel fg)
    {
        // Stage fields only exist in the DOM while the Material Allocation popup is open (see
        // materialAllocationGroup), for both active new-entry and a saved JWO - opening it here
        // is what makes those fields exist just before pendingFocusId targets one of them.
        // Manual allocation (no BOM) has no stages yet the first time this runs for a group -
        // create one on the spot, exactly as BOM selection auto-creates its own via BomChanged.
        var owner = GetGroupOwner(fg);
        materialAllocationReturnFocusId = ComputeMaterialAllocationReturnFocusId(owner);
        materialAllocationGroup = owner;
        if (owner.BomStages.Count == 0 && owner.BillOfMaterialId is null)
        {
            AddManualStage(owner);
            return;
        }

        var firstStage = owner.BomStages.OrderBy(s => s.StageNumber).FirstOrDefault();
        if (firstStage != null)
        {
            pendingFocusId = $"jwo-stage-worker-{firstStage.ClientKey}";
        }
        else
        {
            OpenComponentAllocation(fg);
        }
    }

    private IEnumerable<JobWorkBomLookup> BomsFor(JobWorkFinishedGoodEditModel fg) =>
        lookups.BillOfMaterials.Where(x => x.StockItemId == fg.StockItemId)
            .OrderByDescending(x => x.IsDefault).ThenByDescending(x => x.VersionNumber).ThenBy(x => x.Name);

    private async Task BomChanged(JobWorkFinishedGoodEditModel fg, ChangeEventArgs e)
    {
        fg.BillOfMaterialId = long.TryParse(e.Value?.ToString(), out var id) ? id : null;
        var bom = fg.BillOfMaterialId is long bomId ? lookups.BillOfMaterials.FirstOrDefault(x => x.Id == bomId) : null;
        fg.BillOfMaterialText = bom?.Name ?? string.Empty;
        fg.BomStages.Clear();
        if (fg.BillOfMaterialId is long selectedBomId)
        {
            fg.BomStages = await Repository.BuildBomStagePreviewAsync(
                selectedBomId,
                fg.TotalQuantity,
                null,
                fg.FinishedGoodsGodownId,
                CancellationToken.None);
            var defaultExpectedCompletion = editModel.DueDate ?? editModel.VoucherDate;
            foreach (var stage in fg.BomStages)
                stage.ExpectedCompletionDate = defaultExpectedCompletion;
        }
    }

    private void VoucherDateChanged(DateOnly newVoucherDate)
    {
        var previousVoucherDate = editModel.VoucherDate;
        editModel.VoucherDate = newVoucherDate;
        foreach (var stage in editModel.FinishedGoods.SelectMany(x => x.BomStages))
        {
            if (stage.ExpectedCompletionDate is null || stage.ExpectedCompletionDate == previousVoucherDate)
                stage.ExpectedCompletionDate = newVoucherDate;
        }
        if (editModel.DueDate is null || editModel.DueDate == previousVoucherDate)
        {
            editModel.DueDate = newVoucherDate;
        }
    }

