    private void PopulateOrderRows(MaterialInPendingOrder order)
    {
        fgRows.Clear();
        consumptionRows.Clear();

        foreach (var fg in order.FinishedGoods)
        {
            fgRows.Add(new FgEntryRow
            {
                JwoFinishedGoodId = fg.JwoFinishedGoodId,
                BomStageId = fg.BomStageId,
                StageAssignmentId = fg.StageAssignmentId,
                AssignmentVersion = fg.AssignmentVersion,
                StageName = fg.StageName,
                StockItemName = fg.StockItemName,
                UqcShortName = fg.UqcShortName,
                DecimalPlaces = fg.DecimalPlaces,
                OrderedQuantity = fg.OrderedQuantity,
                PreviouslyReceived = fg.ReceivedQuantity,
                Variants = fg.Variants.Select(v => new VariantEntryRow
                {
                    StockItemVariantId = v.StockItemVariantId,
                    ColourName = v.ColourName,
                    SizeName = v.SizeName,
                    PendingQuantity = v.PendingQuantity
                }).ToList()
            });
        }
        foreach (var row in order.Consumptions)
        {
            consumptionRows.Add(new ConsumptionEntryRow
            {
                JwoComponentId = row.JwoComponentId,
                JwoFinishedGoodId = row.JwoFinishedGoodId,
                BomStageId = row.BomStageId,
                StageAssignmentId = row.StageAssignmentId,
                AssignmentVersion = row.AssignmentVersion,
                StockItemName = row.StockItemName,
                UqcShortName = row.UqcShortName,
                DecimalPlaces = row.DecimalPlaces,
                RequiredQuantity = row.RequiredQuantity,
                IssuedQuantity = row.IssuedQuantity,
                PreviouslyConsumed = row.ConsumedQuantity,
                AvailableQuantity = row.AvailableQuantity
            });
        }
        RecalculateAutomaticConsumption();
    }

    private void RecalculateAutomaticConsumption()
    {
        foreach (var finishedGood in fgRows) RecalculateProcessCharge(finishedGood);
        foreach (var row in consumptionRows)
        {
            var fg = fgRows.FirstOrDefault(x => x.BomStageId == row.BomStageId && x.StageAssignmentId == row.StageAssignmentId);
            if (fg is null || fg.OrderedQuantity <= 0)
            {
                row.Quantity = 0;
                continue;
            }

            var cumulativeReceived = fg.PreviouslyReceived + fg.ReceivedQuantity;
            var plannedCumulativeConsumption = decimal.Round(
                row.RequiredQuantity * cumulativeReceived / fg.OrderedQuantity,
                row.DecimalPlaces,
                MidpointRounding.AwayFromZero);
            var currentReceiptConsumption = plannedCumulativeConsumption - row.PreviouslyConsumed;
            row.Quantity = Math.Min(row.AvailableQuantity, Math.Max(0, currentReceiptConsumption));
        }
    }

    private static void RecalculateProcessCharge(FgEntryRow row)
    {
        if (row.ReceivedQuantity < 0 || (row.ChargeMode == ProcessChargeMode.PerUnit ? row.ProcessCharge : row.TotalCharge) < 0) return;
        (row.ProcessCharge, row.TotalCharge) = ProcessChargeCalculation.Calculate(row.ReceivedQuantity, row.ProcessCharge, row.TotalCharge, row.ChargeMode);
    }

    private static void SetChargeMode(FgEntryRow row, ProcessChargeMode mode)
    {
        row.ChargeMode = mode;
        RecalculateProcessCharge(row);
    }

    private void HandleReceiptQuantityKeyDown(KeyboardEventArgs e, FgEntryRow row, long? variantId)
    {
        if (e.Key != "Enter") return;
        if (variantId is long currentVariantId)
        {
            var currentIndex = row.Variants.FindIndex(x => x.StockItemVariantId == currentVariantId);
            if (currentIndex >= 0 && currentIndex + 1 < row.Variants.Count)
            {
                pendingFocusId = $"mi-fg-qty-{row.StageAssignmentId}-{row.Variants[currentIndex + 1].StockItemVariantId}";
                return;
            }
        }
        pendingFocusId = row.ReceivedQuantity > 0
            ? $"mi-process-charge-{row.BomStageId}-{row.StageAssignmentId}"
            : ReceiptQuantityFocusId(row);
    }

    private static string ReceiptQuantityFocusId(FgEntryRow row) => row.Variants.Count == 0
        ? $"mi-stage-qty-{row.BomStageId}-{row.StageAssignmentId}"
        : $"mi-fg-qty-{row.StageAssignmentId}-{row.Variants[0].StockItemVariantId}";

    private async Task SaveAsync()
    {
        if (busy) return;
        message = string.Empty;
        var validation = Validate();
        if (validation is not null) { SetMessage(validation, true); pendingFocusId = GetValidationFocusId(validation); return; }

        busy = true;
        try
        {
            var request = new MaterialInSaveRequest
            {
                VoucherId = editingVoucherId ?? 0,
                ConcurrencyToken = editingConcurrencyToken,
                VoucherTypeId = defaults.VoucherTypeId,
                VoucherNumber = defaults.VoucherNumber,
                VoucherDate = defaults.VoucherDate,
                ReferenceNumber = referenceNumber,
                Batch = selectedOrder!.Batch,
                JobWorkerLedgerId = selectedJobWorkerId,
                JwoVoucherId = selectedOrder.JwoVoucherId,
                ConsumptionGodownId = consumptionGodownId,
                ReceivingGodownId = receivingGodownId,
                Narration = narration,
                FinishedGoods = fgRows.Where(x => x.ReceivedQuantity > 0).Select(x => new MaterialInFinishedGoodInput
                {
                    JwoFinishedGoodId = x.JwoFinishedGoodId,
                    BomStageId = x.BomStageId,
                    StageAssignmentId = x.StageAssignmentId,
                    ReceivedQuantity = x.ReceivedQuantity,
                    TotalCharge = x.TotalCharge,
                    ProcessCharge = x.ProcessCharge,
                    ChargeMode = x.ChargeMode,
                    Variants = x.Variants.Where(v => v.Quantity > 0).Select(v => new MaterialInVariantInput { StockItemVariantId = v.StockItemVariantId, Quantity = v.Quantity }).ToList()
                }).ToList(),
                Consumptions = consumptionRows.Where(x => x.Quantity > 0).Select(x => new MaterialInConsumptionInput { JwoComponentId = x.JwoComponentId, BomStageId = x.BomStageId, StageAssignmentId = x.StageAssignmentId, ConsumedQuantity = x.Quantity }).ToList()
            };
            var result = await Repository.SaveAsync(request);
            var savedNumber = result.VoucherNumber;
            var wasAlteration = editingVoucherId is not null;
            if (!string.IsNullOrWhiteSpace(ReturnUrl))
            {
                Navigation.NavigateTo(ReturnUrl);
                return;
            }
            defaults = await Repository.GetEntryDefaultsAsync();
            ResetEntry();
            showEntry = true;
            SetMessage($"Material In voucher {savedNumber} {(wasAlteration ? "altered" : "saved")} successfully.", false);
            pendingFocusId = defaults.NumberingMode == "Manual" ? "mi-voucher-number" : "mi-job-worker";
        }
        catch (Exception ex) { SetMessage(GetErrorMessage(ex), true); }
        finally { busy = false; }
    }

    private string? Validate()
    {
        if (selectedJobWorkerId == 0) return "Select a Job Worker.";
        if (selectedOrder is null) return "Select a pending JWO / Order Number.";
        if (consumptionGodownId == 0) return "Select the Consumption Godown.";
        if (receivingGodownId == 0) return "Select the Finished Goods Godown.";
        if (defaults.NumberingMode == "Manual" && string.IsNullOrWhiteSpace(defaults.VoucherNumber)) return "Voucher Number is required.";
        if (!fgRows.Any(x => x.ReceivedQuantity > 0)) return "Enter at least one finished-goods receipt quantity.";
        foreach (var fg in fgRows)
        {
            if (fg.Variants.Any(x => x.Quantity < 0 || x.Quantity > x.PendingQuantity)) return $"Invalid colour/size quantity for {fg.StockItemName}.";
            if (fg.ReceivedQuantity > fg.PendingQuantity) return $"Receipt quantity for {fg.StockItemName} exceeds pending quantity.";
            if (fg.ReceivedQuantity == 0 && fg.TotalCharge > 0) return $"Enter a received quantity for {fg.StockItemName} before applying total process charges.";
            if (fg.ReceivedQuantity > 0 && fg.TotalCharge <= 0) return $"Total process charges for {fg.StockItemName} are required and must be greater than zero.";
        }
        if (!consumptionRows.Any(x => x.Quantity > 0)) return "Enter at least one raw-material consumption quantity.";
        if (consumptionRows.Any(x => x.Quantity < 0 || x.Quantity > x.AvailableQuantity)) return "Raw-material consumption cannot exceed actual available Material Out quantity.";
        return null;
    }

    private string GetValidationFocusId(string validationMessage)
    {
        if (validationMessage.Contains("Job Worker", StringComparison.OrdinalIgnoreCase)) return "mi-job-worker";
        if (validationMessage.Contains("JWO", StringComparison.OrdinalIgnoreCase)) return "mi-order";
        if (validationMessage.Contains("Consumption Godown", StringComparison.OrdinalIgnoreCase)) return "mi-consumption-godown";
        if (validationMessage.Contains("Finished Goods Godown", StringComparison.OrdinalIgnoreCase)) return "mi-receiving-godown";
        if (validationMessage.Contains("Voucher Number", StringComparison.OrdinalIgnoreCase)) return "mi-voucher-number";
        if (validationMessage.Contains("process charges", StringComparison.OrdinalIgnoreCase))
        {
            var row = fgRows.FirstOrDefault(x => x.ReceivedQuantity > 0 && x.TotalCharge <= 0) ?? fgRows.FirstOrDefault();
            if (row is not null) return row.ReceivedQuantity > 0
                ? $"mi-total-charge-{row.BomStageId}-{row.StageAssignmentId}"
                : ReceiptQuantityFocusId(row);
        }
        var firstVariant = fgRows.SelectMany(x => x.Variants).FirstOrDefault();
        return firstVariant is null ? "mi-narration" : $"mi-fg-qty-{firstVariant.StockItemVariantId}";
    }

    private void ResetEntry()
    {
        editingVoucherId = null; editingConcurrencyToken = string.Empty;
        selectedJobWorkerId = 0; selectedOrderId = 0; selectedOrder = null;
        consumptionGodownId = 0; receivingGodownId = 0;
        jobWorkerText = string.Empty; orderText = string.Empty;
        consumptionGodownText = string.Empty; receivingGodownText = string.Empty; activeLookupKey = null;
        referenceNumber = string.Empty; narration = string.Empty;
        orders.Clear(); fgRows.Clear(); consumptionRows.Clear();
    }

    private void OpenCancelModal()
    {
        if (editingVoucherId is null || busy) return;
        cancellationReason = string.Empty;
        cancelMessage = string.Empty;
        showCancelModal = true;
        pendingFocusId = "mi-cancel-reason";
    }

    private async Task DeleteCurrentAsync()
    {
        if (editingVoucherId is null || busy) return;
        var voucherId = editingVoucherId.Value;
        var voucherNumber = defaults.VoucherNumber;
        var confirmed = await JS.InvokeAsync<bool>("texTrackConfirmDelete", "Delete Material In?",
            $"Delete Material In voucher {voucherNumber}? Its stock postings will be removed.", "mi-narration");
        if (!confirmed) return;

        busy = true;
        try
        {
            var result = await Repository.DeleteAsync(voucherId);
            if (!result.Success)
            {
                SetMessage(result.Message, true);
                pendingFocusId = "mi-narration";
                return;
            }

            if (!string.IsNullOrWhiteSpace(ReturnUrl))
            {
                Navigation.NavigateTo(ReturnUrl);
                return;
            }

            defaults = await Repository.GetEntryDefaultsAsync();
            ResetEntry();
            showEntry = true;
            SetMessage(result.Message, false);
            pendingFocusId = defaults.NumberingMode == "Manual" ? "mi-voucher-number" : "mi-job-worker";
        }
        finally { busy = false; }
    }

    private void HandleCancelModalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") CloseCancelModal();
        else if (e.AltKey && string.Equals(e.Key, "x", StringComparison.OrdinalIgnoreCase)) _ = ConfirmCancelAsync();
    }

    private async Task ConfirmCancelAsync()
    {
        if (editingVoucherId is null || busy) return;
        if (string.IsNullOrWhiteSpace(cancellationReason))
        {
            cancelMessage = "Cancellation reason is required.";
            pendingFocusId = "mi-cancel-reason";
            return;
        }

        busy = true;
        try
        {
            var voucherId = editingVoucherId.Value;
            var voucherNumber = defaults.VoucherNumber;
            var result = await Repository.CancelAsync(voucherId, cancellationReason);
            if (!result.Success)
            {
                cancelMessage = result.Message;
                return;
            }
            showCancelModal = false;
            ResetEntry();
            defaults = await Repository.GetEntryDefaultsAsync();
            if (!string.IsNullOrWhiteSpace(ReturnUrl)) { Navigation.NavigateTo(ReturnUrl); return; }
            showEntry = true;
            SetMessage($"Material In {voucherNumber} cancelled successfully.", false);
            pendingFocusId = defaults.NumberingMode == "Manual" ? "mi-voucher-number" : "mi-job-worker";
        }
        finally { busy = false; }
    }

    private void CloseCancelModal()
    {
        showCancelModal = false;
        cancelMessage = string.Empty;
        cancellationReason = string.Empty;
        pendingFocusId = "mi-narration";
    }

    private async Task HandlePageKeyDown(KeyboardEventArgs e)
    {
        if (showEntry)
        {
            if (e.AltKey && string.Equals(e.Key, "a", StringComparison.OrdinalIgnoreCase)) await SaveAsync();
            else if (e.AltKey && string.Equals(e.Key, "x", StringComparison.OrdinalIgnoreCase) && editingVoucherId is not null) OpenCancelModal();
            else if (e.Key == "Escape" && !busy) await HandleVoucherEscapeAsync();
            return;
        }
        if (e.AltKey && string.Equals(e.Key, "c", StringComparison.OrdinalIgnoreCase)) OpenCreate();
        else if (e.Key == "F4") pendingFocusId = "mi-search";
        else if (e.Key == "Enter") await OpenSelected();
        else if (e.Key is "ArrowDown" or "Down" && listRows.Count > 0) SelectListRow(Math.Min(selectedIndex + 1, listRows.Count - 1));
        else if (e.Key is "ArrowUp" or "Up" && listRows.Count > 0) SelectListRow(Math.Max(selectedIndex - 1, 0));
        else if (e.Key == "Escape") await GoBack();
    }

    private async Task HandleVoucherEscapeAsync()
    {
        if (busy) return;

        quitReturnFocusId = await JS.InvokeAsync<string?>("texTrackKeyboardContexts.getActiveElementId");
        var isDirty = await JS.InvokeAsync<bool>("texTrackKeyboardContexts.isVoucherDirty", "material-in-entry");
        if (!isDirty)
        {
            await CloseEntry();
            return;
        }

        showQuitModal = true;
        quitSelectYes = true;
        pendingFocusId = "mi-quit-yes";
    }

    private async Task HandleQuitModalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "ArrowLeft" or "Left" or "ArrowRight" or "Right" or "Tab")
        {
            quitSelectYes = !quitSelectYes;
            pendingFocusId = quitSelectYes ? "mi-quit-yes" : "mi-quit-no";
            return;
        }
        if (e.Key == "Enter")
        {
            if (quitSelectYes) await ConfirmQuitAsync(); else CancelQuit();
            return;
        }
        if (string.Equals(e.Key, "y", StringComparison.OrdinalIgnoreCase))
        {
            await ConfirmQuitAsync();
            return;
        }
        if (string.Equals(e.Key, "n", StringComparison.OrdinalIgnoreCase) || e.Key == "Escape") CancelQuit();
    }

    private async Task ConfirmQuitAsync()
    {
        showQuitModal = false;
        quitReturnFocusId = null;
        await CloseEntry();
    }

    private void CancelQuit()
    {
        showQuitModal = false;
        pendingFocusId = quitReturnFocusId ?? "mi-page-root";
        quitReturnFocusId = null;
    }

    private async Task GoBack() => await JS.InvokeVoidAsync("history.back");
    private void SetMessage(string text, bool error) { message = text; messageIsError = error; }
    private static string GetErrorMessage(Exception ex)
    {
        return VoucherErrorMessages.For(ex);
    }
    private static long ParseLong(object? value) => long.TryParse(Convert.ToString(value), out var parsed) ? parsed : 0;
    private static string FormatQty(decimal value, int decimals) => value.ToString($"F{Math.Clamp(decimals, 0, 6)}");
    private static string StepFor(int decimals) => decimals <= 0 ? "1" : $"0.{new string('0', Math.Max(0, decimals - 1))}1";

