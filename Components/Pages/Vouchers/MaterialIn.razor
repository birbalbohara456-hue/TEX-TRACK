@page "/vouchers/material-in"
@implements IAsyncDisposable
@attribute [Authorize(Policy = SecurityPolicies.OperateVouchers)]
@using Microsoft.AspNetCore.Components.Web
@inject MaterialInRepository Repository
@inject DatabaseStatus Database
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject DeveloperAccessService DeveloperAccess

<PageTitle>Material In - TexTrack ERP</PageTitle>

<div id="mi-page-root" class="page-card voucher-page mi-voucher-page" tabindex="0"
     @onkeydown="HandlePageKeyDown" @onkeydown:stopPropagation="true">
    @if (showEntry)
    {
        <KeyboardContextScope ContextId="material-in-entry" RootElementId="mi-form-root" ContextType="KeyboardContextType.Form" Mode="@(editingVoucherId is null ? KeyboardContextMode.Create : KeyboardContextMode.Alteration)"
                              CanDelete="@(editingVoucherId is not null && !busy)" DeleteAsync="DeleteCurrentAsync"
                              CanCancel="@(editingVoucherId is not null && !busy)" CancelAsync="OpenCancelModal"
                              IsVoucherEntry="true" EscapeAsync="HandleVoucherEscapeAsync" AcceptAsync="SaveAsync" />
    }

    @if (!Database.IsConnected)
    {
        <div class="database-warning"><strong>PostgreSQL setup required</strong><p>@Database.Message</p></div>
    }
    else if (loading)
    {
        <div class="loading-state">Loading Material In…</div>
    }
    else if (!showEntry)
    {
        <!-- LIST VIEW -->
        <div class="page-header">
            <div>
                <p class="eyebrow">INVENTORY VOUCHER · FINISHED GOODS RECEIPT</p>
                <h1>Material In</h1>
            </div>
            <div class="header-actions">
                <button type="button" class="compact-action action-secondary" @onclick="OpenCreate">Alt+C Create</button>
                <button type="button" class="compact-action action-secondary" @onclick="OpenSelected">Enter Alter</button>
            </div>
        </div>

        <KeyboardContextScope ContextId="material-in-list" RootElementId="mi-page-root" ContextType="KeyboardContextType.List" Mode="KeyboardContextMode.List" CanDelete="false" />
        <TexTrack.Web.Components.Vouchers.MaterialIn.MaterialInVoucherList Rows="listRows" SelectedIndex="selectedIndex"
            SearchText="searchText" SearchTextChanged="OnSearchTextChanged" SearchKeyDown="HandleSearchKeyDown"
            CreateRequested="OpenCreate" SelectRequested="SelectListRow" OpenRequested="OpenSelected" />
    }
    else
    {
        <!-- Shared voucher frame; only the Material In transaction body is page-specific. -->
        <VoucherEntryFrame Id="mi-form-root" Class="mi-entry-form" Profile="VoucherLayoutProfiles.MaterialIn"
                           Title="Material In"
                           DayText="@defaults.VoucherDate.ToString("dddd")">
            <DateContent>
                <VoucherDateInput Id="mi-date" Class="header-date" @bind-Value="defaults.VoucherDate" />
            </DateContent>
            <MessageContent>
                @if (!string.IsNullOrWhiteSpace(message))
                {
                    <div class="form-message @(messageIsError ? "error" : "success")">@message</div>
                }
            </MessageContent>
            <ChildContent>
            <div class="voucher-paper-surface p-3 flex flex-col gap-3">

                <!-- MASTER FIELDS PANEL -->
                <section class="panel-light p-2.5 grid grid-cols-12 gap-4">
                    <div class="col-span-9 grid grid-cols-2 gap-x-6 gap-y-1.5">
                        <VoucherField FieldKey="party" For="mi-job-worker">
                            <div class="lookup-field mi-lookup-field">
                                <input id="mi-job-worker" data-erp-lookup="true" data-tt-related-master="/masters/ledgers" autocomplete="new-password" autofocus class="tally-input flex-1 font-medium"
                                       placeholder="Type to search Job Worker" value="@jobWorkerText" readonly="@(editingVoucherId is not null)"
                                       @onfocus="OpenJobWorkerLookup" @oninput="JobWorkerTextChanged" />
                                @if (activeLookupKey == "job-worker" && editingVoucherId is null)
                                {
                                    var workers = FilterJobWorkers().Take(12).ToList();
                                    <div class="erp-lookup-panel">
                                        @foreach (var worker in workers)
                                        {
                                            <button type="button" tabindex="-1" @onmousedown:preventDefault="true" @onclick="() => SelectJobWorkerAsync(worker)"><strong>@worker.Name</strong><span>@worker.GroupName</span></button>
                                        }
                                        @if (workers.Count == 0) { <div class="erp-lookup-empty">No matching Job Worker</div> }
                                    </div>
                                }
                            </div>
                        </VoucherField>

                        <VoucherField FieldKey="order" For="mi-order">
                            <div class="lookup-field mi-lookup-field">
                                <input id="mi-order" data-erp-lookup="true" autocomplete="new-password" class="tally-input flex-1 font-medium"
                                       placeholder="@(loadingOrders ? "Loading pending orders…" : "Type to search pending JWO")" value="@orderText"
                                       readonly="@(editingVoucherId is not null || selectedJobWorkerId == 0 || loadingOrders)" @onfocus="OpenOrderLookup" @oninput="OrderTextChanged" />
                                @if (activeLookupKey == "order" && editingVoucherId is null)
                                {
                                    var pendingOrders = FilterOrders().Take(15).ToList();
                                    <div class="erp-lookup-panel mi-order-lookup-panel">
                                        @foreach (var order in pendingOrders)
                                        {
                                            <button type="button" tabindex="-1" @onmousedown:preventDefault="true" @onclick="() => SelectOrder(order)"><strong>@order.VoucherNumber</strong><span>Batch @order.Batch · @order.VoucherDate.ToString("dd-MM-yyyy")</span></button>
                                        }
                                        @if (pendingOrders.Count == 0) { <div class="erp-lookup-empty">No matching pending JWO</div> }
                                    </div>
                                }
                            </div>
                        </VoucherField>

                        <VoucherField FieldKey="source-godown" For="mi-consumption-godown">
                            <div class="lookup-field mi-lookup-field">
                                <input id="mi-consumption-godown" data-erp-lookup="true" data-tt-related-master="/masters/godowns" autocomplete="new-password" class="tally-input flex-1 font-medium"
                                       placeholder="Selected from linked Material Out" value="@consumptionGodownText" readonly="@(selectedOrder is not null)" @onfocus="OpenConsumptionGodownLookup" @oninput="ConsumptionGodownTextChanged" />
                                @if (activeLookupKey == "consumption-godown")
                                {
                                    var godowns = FilterGodowns(consumptionGodownText).Take(12).ToList();
                                    <div class="erp-lookup-panel">
                                        @foreach (var godown in godowns) { <button type="button" tabindex="-1" @onmousedown:preventDefault="true" @onclick="() => SelectConsumptionGodown(godown)"><strong>@godown.Name</strong></button> }
                                        @if (godowns.Count == 0) { <div class="erp-lookup-empty">No matching Godown</div> }
                                    </div>
                                }
                            </div>
                        </VoucherField>

                        <VoucherField FieldKey="destination-godown" For="mi-receiving-godown">
                            <div class="lookup-field mi-lookup-field">
                                <input id="mi-receiving-godown" data-erp-lookup="true" data-tt-related-master="/masters/godowns" autocomplete="new-password" class="tally-input flex-1 font-medium"
                                       placeholder="Select Finished Goods Godown" value="@receivingGodownText" @onfocus="OpenReceivingGodownLookup" @oninput="ReceivingGodownTextChanged" />
                                @if (activeLookupKey == "receiving-godown")
                                {
                                    var godowns = FilterGodowns(receivingGodownText).Take(12).ToList();
                                    <div class="erp-lookup-panel">
                                        @foreach (var godown in godowns) { <button type="button" tabindex="-1" @onmousedown:preventDefault="true" @onclick="() => SelectReceivingGodown(godown)"><strong>@godown.Name</strong></button> }
                                        @if (godowns.Count == 0) { <div class="erp-lookup-empty">No matching Godown</div> }
                                    </div>
                                }
                            </div>
                        </VoucherField>

                        <VoucherField FieldKey="batch">
                            <input value="@(selectedOrder?.Batch ?? string.Empty)" readonly tabindex="-1" class="tally-input flex-1 font-bold read-only-text" />
                        </VoucherField>

                        <VoucherField FieldKey="reference" For="mi-reference">
                            <input id="mi-reference" @bind="referenceNumber" maxlength="100" class="tally-input flex-1" placeholder="E.g. DC-101" />
                        </VoucherField>
                    </div>

                    <div class="mi-voucher-summary">
                        <label class="mi-voucher-number-field">
                            <span>Voucher No.</span>
                            <input id="mi-voucher-number" @bind="defaults.VoucherNumber"
                                   readonly="@(defaults.NumberingMode != "Manual")"
                                   tabindex="@(defaults.NumberingMode == "Manual" ? 0 : -1)" />
                        </label>
                    </div>
                </section>

                <!-- WORKSPACE AREA -->
                @if (selectedOrder is null)
                {
                    <div class="mi-empty-state">
                        Select Party A/c Name and pending JWO / Order No. to load finished goods receipt and material consumption details.
                    </div>
                }
                else
                {
                    <div class="mi-workspace flex flex-col gap-3">
                        <!-- ITEM GRID TABLE -->
                        <div>
                            <div class="flex items-center gap-1.5 mb-1 pl-0.5">
                                <span class="font-bold text-[#1D2835] uppercase text-[10px] tracking-wider">Stage Outputs Received</span>
                            </div>
                            <table class="erp-table">
                                <thead>
                                    <tr>
                                        <th class="w-[35%] text-left">Item Name / Details</th>
                                        <th class="w-[15%] text-right">Pending Qty</th>
                                        <th class="w-[15%] text-right">Received Qty</th>
                                        <th class="w-[10%] text-center">UQC</th>
                                        <th class="w-[12%] text-right">P.Charge (/unit)</th>
                                        <th class="w-[12%] text-right">Total Charges</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var fg in fgRows)
                                    {
                                        <tr class="fg-title-row" @key="(fg.BomStageId, fg.StageAssignmentId)">
                                            <td colspan="6" class="p-0">
                                                <div class="fg-title-wrap p-2 bg-[#F5F8FB]">
                                                    <div>
                                                        <strong class="text-[13px] text-[#1D2835]">@fg.StageName · @fg.StockItemName · Assignment v@(fg.AssignmentVersion)</strong>
                                                        <span class="ml-2 text-[11px] text-[#657487]">(Ordered @FormatQty(fg.OrderedQuantity, fg.DecimalPlaces) · Prev Received @FormatQty(fg.PreviouslyReceived, fg.DecimalPlaces) · Pending @FormatQty(fg.PendingQuantity, fg.DecimalPlaces) @fg.UqcShortName)</span>
                                                    </div>
                                                    <div class="fg-process-wrap">
                                                        <label class="field-label">Process Charge / Unit:</label>
                                                        <input id="mi-process-charge-@fg.BomStageId-@fg.StageAssignmentId" type="number" min="0" step="0.0001"
                                                               disabled="@(fg.ReceivedQuantity <= 0)"
                                                               @bind="fg.ProcessCharge" @bind:event="oninput" @bind:after="() => SetChargeMode(fg, ProcessChargeMode.PerUnit)" title="Enter rate per unit; total is calculated" class="tally-input w-24 text-right font-bold" />
                                                        <label class="field-label">Total Charges:</label>
                                                        <input id="mi-total-charge-@fg.BomStageId-@fg.StageAssignmentId" type="number" min="0.01" step="0.01" required
                                                               disabled="@(fg.ReceivedQuantity <= 0)"
                                                               @bind="fg.TotalCharge" @bind:event="oninput" @bind:after="() => SetChargeMode(fg, ProcessChargeMode.Total)" title="Enter total; rate per unit is calculated" class="tally-input w-24 text-right font-bold" />
                                                        <small>@(fg.ChargeMode == ProcessChargeMode.PerUnit ? "Rate entered · total calculated" : "Total entered · rate calculated")</small>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>

                                        <!-- VARIANT ALLOCATION CELLS -->
                                        <tr>
                                            <td colspan="6" class="variant-matrix-cell p-2">
                                                <div class="mi-variant-grid grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-2 bg-[#F5F8FB] p-2 border border-[#C8D1DB] rounded-[2px]">
                                                    @if (fg.Variants.Count == 0)
                                                    {
                                                        <label class="mi-variant-cell flex flex-col p-1.5 bg-white border border-[#9AA8B6] rounded-[2px]">
                                                            <span class="variant-title font-bold text-[#1D2835] text-[11px]">Stage output quantity</span>
                                                            <small class="variant-pending text-[10px] text-[#657487] mb-1">Pending @FormatQty(fg.PendingQuantity, fg.DecimalPlaces)</small>
                                                             <input id="mi-stage-qty-@fg.BomStageId-@fg.StageAssignmentId" type="number" min="0" max="@fg.PendingQuantity" step="@StepFor(fg.DecimalPlaces)"
                                                                    @bind="fg.DirectQuantity" @bind:event="oninput" @bind:after="RecalculateAutomaticConsumption"
                                                                    @onkeydown="e => HandleReceiptQuantityKeyDown(e, fg, null)" @onkeydown:stopPropagation="true"
                                                                    class="tally-input text-right font-mono font-bold text-[#2F6B4B]" />
                                                        </label>
                                                    }
                                                    @foreach (var variant in fg.Variants)
                                                    {
                                                        <label class="mi-variant-cell flex flex-col p-1.5 bg-white border border-[#9AA8B6] rounded-[2px]" @key="variant.StockItemVariantId">
                                                            <span class="variant-title font-bold text-[#1D2835] text-[11px]">@variant.ColourName / @variant.SizeName</span>
                                                            <small class="variant-pending text-[10px] text-[#657487] mb-1">Pending @FormatQty(variant.PendingQuantity, fg.DecimalPlaces)</small>
                                                             <input id="mi-fg-qty-@fg.StageAssignmentId-@variant.StockItemVariantId" type="number" min="0" max="@variant.PendingQuantity" step="@StepFor(fg.DecimalPlaces)"
                                                                    @bind="variant.Quantity" @bind:event="oninput" @bind:after="RecalculateAutomaticConsumption"
                                                                    @onkeydown="e => HandleReceiptQuantityKeyDown(e, fg, variant.StockItemVariantId)" @onkeydown:stopPropagation="true"
                                                                    class="tally-input text-right font-mono font-bold text-[#2F6B4B]" />
                                                        </label>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                        @if (fg.ReceivedQuantity > fg.PendingQuantity)
                                        {
                                            <tr><td colspan="6" class="inline-warning">Receipt quantity exceeds pending quantity.</td></tr>
                                        }
                                    }
                                </tbody>
                                <tfoot>
                                    <tr>
                                        <td class="text-right uppercase text-[10px] font-bold" colspan="2">Voucher Totals</td>
                                        <td class="text-right font-mono text-[11px] font-bold">@FinishedGoodsTotalQuantity</td>
                                        <td class="text-center text-[10px] font-bold">@FinishedGoodsTotalUqc</td>
                                        <td></td>
                                        <td class="text-right font-mono text-[12px] font-black text-[#1D2835]">₹ @fgRows.Sum(x => x.TotalCharge).ToString("N2")</td>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>

                        <!-- RAW MATERIAL CONSUMPTION SECTION -->
                        <div>
                            <div class="flex items-center gap-1.5 mb-1 pl-0.5">
                                <span class="font-bold text-[#1D2835] uppercase text-[10px] tracking-wider">Auto-Deducted Raw Material Consumption</span>
                                <span class="ml-auto text-[11px] font-bold text-[#2F6B4B]">Total Consumed: @TotalConsumed.ToString("0.####")</span>
                            </div>
                            <table class="erp-table">
                                <thead>
                                    <tr>
                                        <th class="w-[35%] text-left">Component Item Name</th>
                                        <th class="text-right">Jobber Stock (Issued)</th>
                                        <th class="text-right">Prev. Consumed</th>
                                        <th class="text-right">Available</th>
                                        <th class="text-right">Consume Now</th>
                                        <th class="text-center">UQC</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in consumptionRows)
                                    {
                                        <tr @key="(row.JwoComponentId, row.StageAssignmentId)">
                                            <td class="font-semibold text-[#33465A]">@row.StockItemName</td>
                                            <td class="text-right font-mono text-[11px]">@FormatQty(row.IssuedQuantity, row.DecimalPlaces)</td>
                                            <td class="text-right font-mono text-[11px] text-[#657487]">@FormatQty(row.PreviouslyConsumed, row.DecimalPlaces)</td>
                                            <td class="text-right font-mono text-[11px] font-bold text-[#2F6B4B]">@FormatQty(row.AvailableQuantity, row.DecimalPlaces)</td>
                                            <td class="text-right font-mono font-bold text-[#1D2835] text-[11px]">
                                                <input type="number" min="0" max="@row.AvailableQuantity" step="@StepFor(row.DecimalPlaces)"
                                                       value="@row.Quantity.ToString($"F{row.DecimalPlaces}")" readonly tabindex="-1" class="tally-input w-full text-right font-mono font-bold read-only-qty" />
                                            </td>
                                            <td class="text-center font-medium">@row.UqcShortName</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>

                        <div class="mi-gross-total" aria-label="Gross total charges">
                            <span>Gross Total Charges</span>
                            <strong>₹ @fgRows.Sum(x => x.TotalCharge).ToString("N2")</strong>
                        </div>
                    </div>
                }

                <section class="mi-narration-section">
                    <label for="mi-narration">Narration <span>:</span></label>
                    <textarea id="mi-narration" rows="2" maxlength="500" @bind="narration" class="tally-input" placeholder="Enter remarks…"></textarea>
                </section>

                @if (editingVoucherId is long auditVoucherId)
                {
                    <VoucherAuditStamp VoucherId="@auditVoucherId" />
                }
                <footer class="mi-save-actions">
                    <div class="mi-footer-primary">
                        <button type="button" class="mi-footer-command" @onclick="HandleVoucherEscapeAsync" disabled="@busy"><b>Esc</b> Quit</button>
                        <button id="mi-save" type="button" class="mi-footer-command is-accept" data-enter-save="true" data-voucher-save-action="true" @onclick="SaveAsync" disabled="@busy"><b>Alt+A</b> @(editingVoucherId is null ? "Accept" : "Update")</button>
                    </div>
                    <span class="mi-footer-help">Enter: Next field · Backspace: Previous field · F2: Date</span>
                    @if (editingVoucherId is not null)
                    {
                        <div class="mi-footer-secondary">
                            <button type="button" class="mi-footer-command is-danger" @onclick="DeleteCurrentAsync" disabled="@busy"><b>Alt+D</b> Delete</button>
                            <button type="button" class="mi-footer-command is-danger" @onclick="OpenCancelModal" disabled="@busy"><b>Alt+X</b> Cancel</button>
                        </div>
                    }
                </footer>

            </div>
            </ChildContent>
        </VoucherEntryFrame>
    }

    <!-- QUIT CONFIRMATION MODAL -->
    @if (showQuitModal)
    {
        <div class="tt-dialog-overlay" role="presentation">
            <section class="tt-dialog" role="dialog" aria-modal="true" aria-labelledby="mi-quit-title" tabindex="0"
                     @onkeydown="HandleQuitModalKeyDown" @onkeydown:stopPropagation="true" @onkeydown:preventDefault="true">
                <header class="tt-dialog-titlebar"><strong id="mi-quit-title">Quit?</strong></header>
                <div class="tt-dialog-body"><p>Quit? Yes or No</p></div>
                <footer class="tt-dialog-actions">
                    <button id="mi-quit-yes" type="button" class="@(quitSelectYes ? "dialog-selected" : null)" @onclick="ConfirmQuitAsync">Yes</button>
                    <button id="mi-quit-no" type="button" class="@(!quitSelectYes ? "dialog-selected" : null)" @onclick="CancelQuit">No</button>
                </footer>
            </section>
        </div>
    }

    @if (showCancelModal)
    {
        <div class="tally-modal-overlay" role="presentation">
            <section class="tally-modal-window" role="dialog" aria-modal="true" aria-labelledby="mi-cancel-title" tabindex="0"
                     @onkeydown="HandleCancelModalKeyDown" @onkeydown:stopPropagation="true" style="width: 430px; min-height: auto;">
                <header class="tally-modal-titlebar"><strong id="mi-cancel-title">Cancel Material In?</strong></header>
                <div class="tt-dialog-body" style="padding: 15px;">
                    <p>Cancel Material In <strong>@defaults.VoucherNumber</strong>? Stock postings will be reversed and the voucher will remain for audit.</p>
                    <label class="tt-cancel-reason">Cancellation Reason <b>*</b>
                        <textarea id="mi-cancel-reason" maxlength="500" @bind="cancellationReason" rows="3"></textarea>
                    </label>
                    @if (!string.IsNullOrWhiteSpace(cancelMessage)) { <div class="form-message error">@cancelMessage</div> }
                </div>
                <footer class="tt-dialog-actions">
                    <button type="button" class="compact-action action-danger" @onclick="ConfirmCancelAsync" disabled="@busy">Cancel Voucher</button>
                    <button type="button" class="compact-action action-secondary" @onclick="CloseCancelModal" disabled="@busy">Return</button>
                </footer>
            </section>
        </div>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "voucherId")] public long? VoucherId { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

    private MaterialInVoucherDefaults defaults = new();
    private MaterialInLookupData lookup = new();
    private DotNetObjectReference<MaterialIn>? relatedMasterRefreshReference;
    private List<MaterialInPendingOrder> orders = new();
    private MaterialInPendingOrder? selectedOrder;
    private List<FgEntryRow> fgRows = new();
    private List<ConsumptionEntryRow> consumptionRows = new();
    private long selectedJobWorkerId;
    private long selectedOrderId;
    private long consumptionGodownId;
    private long receivingGodownId;
    private string jobWorkerText = string.Empty;
    private string orderText = string.Empty;
    private string consumptionGodownText = string.Empty;
    private string receivingGodownText = string.Empty;
    private string? activeLookupKey;
    private string referenceNumber = string.Empty;
    private string narration = string.Empty;
    private string message = string.Empty;
    private bool messageIsError;
    private List<MaterialInListItem> listRows = new();
    private long? editingVoucherId;
    private string editingConcurrencyToken = string.Empty;
    private bool showEntry;
    private int selectedIndex = -1;
    private string searchText = string.Empty;
    private string? pendingFocusId;
    private void FocusMaterialInDate() => pendingFocusId = "mi-date";
    private bool loading = true;
    private bool showQuitModal;
    private bool quitSelectYes = true;
    private string? quitReturnFocusId;
    private bool loadingOrders;
    private bool busy;
    private bool showCancelModal;
    private string cancellationReason = string.Empty;
    private string cancelMessage = string.Empty;

    private decimal TotalReceived => fgRows.Sum(x => x.ReceivedQuantity);
    private string FinishedGoodsTotalQuantity => UqcFinishedGoodsTotals.Count == 1
        ? UqcFinishedGoodsTotals[0].Quantity.ToString("0.####")
        : string.Join(" · ", UqcFinishedGoodsTotals.Select(x => $"{x.Quantity:0.####} {x.Uqc}"));
    private string FinishedGoodsTotalUqc => UqcFinishedGoodsTotals.Count == 1 ? UqcFinishedGoodsTotals[0].Uqc : "MIXED";
    private List<(string Uqc, decimal Quantity)> UqcFinishedGoodsTotals => fgRows
        .GroupBy(x => x.UqcShortName, StringComparer.OrdinalIgnoreCase)
        .Select(x => (Uqc: x.Key, Quantity: x.Sum(y => y.ReceivedQuantity)))
        .Where(x => x.Quantity != 0)
        .ToList();
    private decimal TotalConsumed => consumptionRows.Sum(x => x.Quantity);

    protected override async Task OnInitializedAsync()
    {
        if (!Database.IsConnected) { loading = false; return; }
        try
        {
            defaults = await Repository.GetEntryDefaultsAsync();
            lookup = await Repository.GetLookupDataAsync();
            if (VoucherId is not null) await OpenVoucherAsync(VoucherId.Value);
            else OpenCreate();
        }
        catch (Exception ex) { SetMessage(VoucherErrorMessages.For(ex), true); }
        finally { loading = false; }
    }

    private async Task LoadListAsync(long? selectId = null)
    {
        listRows = (await Repository.GetListAsync(searchText)).ToList();
        if (listRows.Count == 0) selectedIndex = -1;
        else if (selectId is not null)
        {
            selectedIndex = listRows.FindIndex(x => x.VoucherId == selectId.Value);
            if (selectedIndex < 0) selectedIndex = 0;
        }
        else selectedIndex = Math.Clamp(selectedIndex < 0 ? 0 : selectedIndex, 0, listRows.Count - 1);
        pendingFocusId = selectedIndex >= 0 ? $"mi-row-{listRows[selectedIndex].VoucherId}" : "mi-page-root";
    }

    private void OpenCreate()
    {
        editingVoucherId = null;
        editingConcurrencyToken = string.Empty;
        ResetEntry();
        showEntry = true;
        message = string.Empty;
        pendingFocusId = defaults.NumberingMode == "Manual" ? "mi-voucher-number" : "mi-job-worker";
    }

    private async Task OpenSelected()
    {
        if (selectedIndex < 0 || selectedIndex >= listRows.Count || busy) return;
        await OpenVoucherAsync(listRows[selectedIndex].VoucherId);
    }

    private async Task OpenVoucherAsync(long voucherId)
    {
        var data = await Repository.GetForEditAsync(voucherId);
        if (data is null)
        {
            SetMessage("The selected Material In voucher no longer exists.", true);
            await LoadListAsync();
            return;
        }
        if (string.Equals(data.Status, "Cancelled", StringComparison.OrdinalIgnoreCase) && !DeveloperAccess.IsDeveloper)
        {
            SetMessage("A cancelled Material In voucher cannot be altered.", true);
            await LoadListAsync(voucherId);
            return;
        }

        editingVoucherId = data.VoucherId;
        editingConcurrencyToken = data.ConcurrencyToken;
        defaults = data.Defaults;
        selectedJobWorkerId = data.JobWorkerLedgerId;
        consumptionGodownId = data.ConsumptionGodownId;
        receivingGodownId = data.ReceivingGodownId;
        referenceNumber = data.ReferenceNumber;
        narration = data.Narration;
        orders = (await Repository.GetPendingOrdersAsync(selectedJobWorkerId, editingVoucherId)).ToList();
        selectedOrderId = data.JwoVoucherId;
        selectedOrder = orders.FirstOrDefault(x => x.JwoVoucherId == selectedOrderId);
        if (selectedOrder is null)
        {
            SetMessage("The original JWO / Order Number is unavailable or cancelled.", true);
            return;
        }
        jobWorkerText = JobWorkerFieldText(lookup.JobWorkers.FirstOrDefault(x => x.Id == selectedJobWorkerId));
        orderText = OrderDisplay(selectedOrder);
        consumptionGodownText = lookup.Godowns.FirstOrDefault(x => x.Id == consumptionGodownId)?.Name ?? string.Empty;
        receivingGodownText = lookup.Godowns.FirstOrDefault(x => x.Id == receivingGodownId)?.Name ?? string.Empty;
        PopulateOrderRows(selectedOrder);
        foreach (var saved in data.FinishedGoods)
        {
            var row = fgRows.FirstOrDefault(x => x.JwoFinishedGoodId == saved.JwoFinishedGoodId && x.StageAssignmentId == saved.StageAssignmentId);
            if (row is null) continue;
            if (saved.BomStageId != 0) row = fgRows.FirstOrDefault(x => x.BomStageId == saved.BomStageId && x.StageAssignmentId == saved.StageAssignmentId) ?? row;
            row.TotalCharge = saved.TotalCharge;
            row.ChargeMode = saved.ChargeMode;
            if (row.Variants.Count == 0) row.DirectQuantity = saved.ReceivedQuantity;
            row.ProcessCharge = saved.ProcessCharge;
            foreach (var allocation in saved.Variants)
            {
                var variant = row.Variants.FirstOrDefault(x => x.StockItemVariantId == allocation.StockItemVariantId);
                if (variant is not null) variant.Quantity = allocation.Quantity;
            }
        }
        foreach (var row in fgRows) RecalculateProcessCharge(row);
        foreach (var saved in data.Consumptions)
        {
            var row = consumptionRows.FirstOrDefault(x => x.JwoComponentId == saved.JwoComponentId && x.StageAssignmentId == saved.StageAssignmentId);
            if (row is not null) row.Quantity = saved.ConsumedQuantity;
        }
        showEntry = true;
        message = $"Material In {defaults.VoucherNumber} opened in alteration mode.";
        messageIsError = false;
        pendingFocusId = "mi-date";
    }

