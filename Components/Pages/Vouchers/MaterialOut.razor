    private async Task HandleVoucherEscapeAsync()
    {
        exitReturnFocusId = await JS.InvokeAsync<string?>("texTrackKeyboardContexts.getActiveElementId");
        var isDirty = await JS.InvokeAsync<bool>("texTrackKeyboardContexts.isVoucherDirty", "material-out-form");
        if (!isDirty)
        {
            ConfirmExitVoucher();
            return;
        }

        activeLookupKey = null;
        showExitModal = true;
        exitModalSelectYes = true;
        pendingFocusId = "mo-exit-yes";
    }

    private void HandleExitModalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "ArrowLeft" or "ArrowRight" or "Tab")
        {
            exitModalSelectYes = !exitModalSelectYes;
            pendingFocusId = exitModalSelectYes ? "mo-exit-yes" : "mo-exit-no";
            return;
        }
        if (e.Key == "Enter")
        {
            if (exitModalSelectYes) ConfirmExitVoucher(); else CancelExitVoucher();
            return;
        }
        if (string.Equals(e.Key, "y", StringComparison.OrdinalIgnoreCase))
        {
            ConfirmExitVoucher();
            return;
        }
        if (string.Equals(e.Key, "n", StringComparison.OrdinalIgnoreCase))
        {
            CancelExitVoucher();
            return;
        }
        if (e.Key == "Escape") CancelExitVoucher();
    }

    private void ConfirmExitVoucher()
    {
        if (!string.IsNullOrWhiteSpace(ReturnUrl))
        {
            Navigation.NavigateTo(ReturnUrl);
            return;
        }
        Navigation.NavigateTo("/");
    }

    private void CancelExitVoucher()
    {
        showExitModal = false;
        pendingFocusId = exitReturnFocusId ?? "mo-form-root";
        exitReturnFocusId = null;
    }

    private void PromptDeleteSelected()
    {
        if (selectedIndex < 0 || selectedIndex >= rows.Count) return;
        actionVoucherId = rows[selectedIndex].Id;
        currentActionVoucherNumber = rows[selectedIndex].VoucherNumber;
        showDeleteModal = true;
        actionModalSelectYes = false;
        actionMessage = string.Empty;
        pendingFocusId = "mo-delete-no";
    }

    private void PromptDeleteCurrent()
    {
        if (editingVoucherId is null) return;
        actionVoucherId = editingVoucherId;
        currentActionVoucherNumber = defaults.VoucherNumber;
        showDeleteModal = true;
        actionModalSelectYes = false;
        actionMessage = string.Empty;
        pendingFocusId = "mo-delete-no";
    }

    private void PromptCancelCurrent()
    {
        if (editingVoucherId is null || isCancelledVoucher) return;
        actionVoucherId = editingVoucherId;
        currentActionVoucherNumber = defaults.VoucherNumber;
        cancellationReason = string.Empty;
        actionMessage = string.Empty;
        showCancelModal = true;
        pendingFocusId = "mo-cancel-reason";
    }

    private void HandleDeleteModalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key is "ArrowLeft" or "ArrowRight" or "Tab")
        {
            actionModalSelectYes = !actionModalSelectYes;
            pendingFocusId = actionModalSelectYes ? "mo-delete-yes" : "mo-delete-no";
        }
        else if (e.Key == "Enter")
        {
            if (actionModalSelectYes) _ = ConfirmDeleteAsync(); else CloseDeleteModal();
        }
        else if (e.Key == "Escape") CloseDeleteModal();
    }

    private async Task ConfirmDeleteAsync()
    {
        if (actionVoucherId is null || busy) return;
        busy = true;
        try
        {
            var result = await Repository.DeleteAsync(actionVoucherId.Value);
            if (!result.Success)
            {
                actionMessage = result.Message;
                return;
            }
            showDeleteModal = false;
            editingVoucherId = null;
            if (!string.IsNullOrWhiteSpace(ReturnUrl)) { Navigation.NavigateTo(ReturnUrl); return; }
            await OpenCreate();
            message = result.Message;
            messageIsError = false;
            pendingFocusId = defaults.NumberingMode == "Manual" ? "mo-voucher-number" : "mo-job-worker";
        }
        finally { busy = false; }
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        actionVoucherId = null;
        pendingFocusId = showForm ? "mo-job-worker" : "mo-page-root";
    }

    private void HandleCancelModalKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape") { CloseCancelModal(); return; }
        if (e.AltKey && string.Equals(e.Key, "x", StringComparison.OrdinalIgnoreCase))
            _ = ConfirmCancelAsync();
    }

    private async Task ConfirmCancelAsync()
    {
        if (actionVoucherId is null || busy) return;
        if (string.IsNullOrWhiteSpace(cancellationReason))
        {
            actionMessage = "Cancellation reason is required.";
            pendingFocusId = "mo-cancel-reason";
            return;
        }
        busy = true;
        try
        {
            var result = await Repository.CancelAsync(actionVoucherId.Value, cancellationReason);
            if (!result.Success)
            {
                actionMessage = result.Message;
                return;
            }
            showCancelModal = false;
            editingVoucherId = null;
            if (!string.IsNullOrWhiteSpace(ReturnUrl)) { Navigation.NavigateTo(ReturnUrl); return; }
            await OpenCreate();
            message = result.Message;
            messageIsError = false;
            pendingFocusId = defaults.NumberingMode == "Manual" ? "mo-voucher-number" : "mo-job-worker";
        }
        finally { busy = false; }
    }

    private void CloseCancelModal()
    {
        showCancelModal = false;
        actionVoucherId = null;
        actionMessage = string.Empty;
        pendingFocusId = "mo-save";
    }

