    private static string FormatQuantity(decimal value, int decimals) => value.ToString($"F{Math.Clamp(decimals, 0, 6)}");
    private static int GetOrderDecimalPlaces(MaterialOutPendingOrder order) =>
        order.FinishedGoods.SelectMany(x => x.Components).Select(x => x.DecimalPlaces).DefaultIfEmpty(2).Max();
    private static int GetFinishedGoodDecimalPlaces(MaterialOutPendingFinishedGood fg) =>
        fg.Components.Select(x => x.DecimalPlaces).DefaultIfEmpty(2).Max();
    private string FormatTotalQuantity()
    {
        var lines = SelectedLines.ToList();
        if (lines.Count == 0) return string.Empty;
        var decimals = lines.Max(x => x.DecimalPlaces);
        return FormatQuantity(lines.Sum(x => x.IssueNowQuantity), decimals);
    }
