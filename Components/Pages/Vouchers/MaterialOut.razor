    private void OpenJobWorkerLookup()
    {
        // Party A/c Name is immutable once a voucher is opened in alteration - it
        // defines the alteration's Job Worker/JWO ownership chain, same rule as the
        // JWO link itself. The field stays readonly and its lookup never opens.
        if (editingVoucherId is not null) return;
        activeLookupKey = "job-worker";
        workerLookupIndex = -1;
    }

    private void JobWorkerTextChanged(ChangeEventArgs e)
    {
        if (editingVoucherId is not null) return;
        jobWorkerText = e.Value?.ToString() ?? string.Empty;
        selectedJobWorkerId = null;
        activeLookupKey = "job-worker";
        workerLookupIndex = -1;
    }

    private async Task JobWorkerTextCommitted(ChangeEventArgs e)
    {
        jobWorkerText = e.Value?.ToString() ?? string.Empty;
        var exact = lookup.JobWorkers.FirstOrDefault(x => string.Equals(x.Name, jobWorkerText.Trim(), StringComparison.OrdinalIgnoreCase));
        if (exact is not null) await SelectJobWorker(exact);
    }

    // 🔴 FIX: KEYBOARD ARROW UP/DOWN & ENTER SELECTION FOR PARTY A/C NAME
    private async Task HandlePartyKeyDown(KeyboardEventArgs e)
    {
        // Party A/c Name is immutable during alteration (see OpenJobWorkerLookup) -
        // the field is readonly, but readonly does not stop keydown handlers, so
        // Arrow Up/Down must be blocked here too or they can still reopen the
        // lookup dropdown on a field the user can no longer actually change.
        if (editingVoucherId is not null) return;
        var workers = FilterJobWorkers().Take(12).ToList();

        if (e.Key is "ArrowDown" or "Down")
        {
            if (activeLookupKey != "job-worker") activeLookupKey = "job-worker";
            if (workers.Count > 0) workerLookupIndex = workerLookupIndex < 0 ? 0 : (workerLookupIndex + 1) % workers.Count;
            return;
        }
        if (e.Key is "ArrowUp" or "Up")
        {
            if (activeLookupKey != "job-worker") activeLookupKey = "job-worker";
            if (workers.Count > 0) workerLookupIndex = workerLookupIndex < 0 ? workers.Count - 1 : (workerLookupIndex - 1 + workers.Count) % workers.Count;
            return;
        }
        if (e.Key == "Enter")
        {
            JobWorkerLookupItem? selected = null;
            if (workers.Count > 0 && workerLookupIndex >= 0 && workerLookupIndex < workers.Count)
            {
                selected = workers[workerLookupIndex];
            }
            else
            {
                var text = jobWorkerText.Trim();
                selected = lookup.JobWorkers.FirstOrDefault(x => string.Equals(x.Name, text, StringComparison.OrdinalIgnoreCase))
                           ?? workers.FirstOrDefault();
            }

            if (selected is not null)
            {
                await SelectJobWorker(selected);
            }
            else
            {
                activeLookupKey = null;
                workerLookupIndex = -1;
                pendingFocusId = "mo-order-number";
            }
            return;
        }
        if (e.Key == "Escape")
        {
            activeLookupKey = null;
            workerLookupIndex = -1;
            await HandleVoucherEscapeAsync();
            return;
        }
    }

    private IEnumerable<JobWorkerLookupItem> FilterJobWorkers()
    {
        var term = jobWorkerText.Trim();
        return string.IsNullOrWhiteSpace(term)
            ? lookup.JobWorkers
            : lookup.JobWorkers.Where(x => x.Name.Contains(term, StringComparison.OrdinalIgnoreCase) || x.GroupName.Contains(term, StringComparison.OrdinalIgnoreCase));
    }

    private async Task SelectJobWorker(JobWorkerLookupItem worker)
    {
        // The Job Worker/JWO pairing defines an alteration's ownership and dependency
        // chain and is already loaded correctly by OpenSelectedAsync - Party A/c Name
        // is immutable during alteration (readonly field, lookup never opens), so this
        // must be a true no-op here too rather than applying the new worker and only
        // suppressing the pending-order reload, which left the visible worker changed
        // while the JWO lines stayed from the original one.
        if (editingVoucherId is not null)
        {
            pendingFocusId = SelectedLines.Select(x => $"mo-qty-{x.JwoComponentId}").FirstOrDefault() ?? "mo-narration";
            return;
        }

        selectedJobWorkerId = worker.Id;
        jobWorkerText = worker.Name;
        activeLookupKey = null; // 🔴 CLOSE LOOKUP IMMEDIATELY ON SELECTION
        workerLookupIndex = -1;

        if (destinationGodownId is null && worker.DefaultMaterialOutDestinationGodownId is not null)
        {
            destinationGodownId = worker.DefaultMaterialOutDestinationGodownId;
            destinationGodownText = worker.DefaultMaterialOutDestinationGodownName;
        }
        await LoadPendingAsync();
    }

    private void OpenOrderLookup()
    {
        // JWO / Order No. is immutable during alteration, same rule as Party A/c Name
        // above - the field stays readonly and its lookup never opens.
        if (editingVoucherId is not null) return;
        if (selectedJobWorkerId is not null)
        {
            activeLookupKey = "order";
            orderLookupIndex = -1;
        }
    }

    private void OrderTextChanged(ChangeEventArgs e)
    {
        if (editingVoucherId is not null) return;
        orderNumberText = e.Value?.ToString() ?? string.Empty;
        if (selectedJobWorkerId is not null)
        {
            activeLookupKey = "order";
            orderLookupIndex = -1;
        }
    }

    // 🔴 FIX: KEYBOARD ARROW UP/DOWN & ENTER SELECTION FOR JWO ORDER NO
    private async Task HandleOrderKeyDown(KeyboardEventArgs e)
    {
        // JWO / Order No. is immutable during alteration - see OpenOrderLookup.
        if (editingVoucherId is not null) return;
        var pendingOrders = FilterOrders().Take(15).ToList();

        if (e.Key is "ArrowDown" or "Down")
        {
            if (activeLookupKey != "order") activeLookupKey = "order";
            if (pendingOrders.Count > 0) orderLookupIndex = orderLookupIndex < 0 ? 0 : (orderLookupIndex + 1) % pendingOrders.Count;
            return;
        }
        if (e.Key is "ArrowUp" or "Up")
        {
            if (activeLookupKey != "order") activeLookupKey = "order";
            if (pendingOrders.Count > 0) orderLookupIndex = orderLookupIndex < 0 ? pendingOrders.Count - 1 : (orderLookupIndex - 1 + pendingOrders.Count) % pendingOrders.Count;
            return;
        }
        if (e.Key == "Enter")
        {
            if (pendingOrders.Count > 0 && orderLookupIndex >= 0 && orderLookupIndex < pendingOrders.Count)
            {
                var chosenOrder = pendingOrders[orderLookupIndex];
                var index = orders.IndexOf(chosenOrder);
                if (index >= 0) await SelectOrder(index);
            }
            else if (selectedOrder is not null)
            {
                activeLookupKey = null;
                orderLookupIndex = -1;
                pendingFocusId = SelectedLines.Select(x => $"mo-qty-{x.JwoComponentId}").FirstOrDefault() ?? "mo-narration";
            }
            return;
        }
        if (e.Key == "Escape")
        {
            activeLookupKey = null;
            orderLookupIndex = -1;
        }
    }

    private IEnumerable<MaterialOutPendingOrder> FilterOrders()
    {
        var term = orderNumberText.Trim();
        if (string.IsNullOrWhiteSpace(term) || selectedOrder is not null && string.Equals(term, selectedOrder.VoucherNumber, StringComparison.OrdinalIgnoreCase))
            return orders;
        return orders.Where(x => x.VoucherNumber.Contains(term, StringComparison.OrdinalIgnoreCase)
            || x.Batch.Contains(term, StringComparison.OrdinalIgnoreCase)
            || x.ReferenceNumber.Contains(term, StringComparison.OrdinalIgnoreCase));
    }

