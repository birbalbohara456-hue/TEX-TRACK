@page "/vouchers/material-out"
@implements IAsyncDisposable
@attribute [Authorize(Policy = SecurityPolicies.OperateVouchers)]
@using System.Globalization
@inject MaterialOutRepository Repository
@inject DatabaseStatus Database
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject DeveloperAccessService DeveloperAccess
@inject StockPositionService StockPosition

<PageTitle>Material Out</PageTitle>

<div id="mo-page-root" class="page-card mo-page" tabindex="0" @ref="pageRoot" @onkeydown="HandlePageKeyDown" @onkeydown:stopPropagation="true">
    <KeyboardContextScope ContextId="material-out-list" RootElementId="mo-page-root"
                          ContextType="KeyboardContextType.List" Mode="KeyboardContextMode.List"
                          CanDelete="@(selectedIndex >= 0 && !busy)" DeleteAsync="PromptDeleteSelected" />
    
    @if (!Database.IsConnected)
    {
        <div class="database-warning"><strong>PostgreSQL setup required</strong><p>@Database.Message</p></div>
    }
    else if (loading)
    {
        <div class="loading-state">Loading Material Out…</div>
    }
    else
    {
        @if (!showForm)
        {
            <!-- LIST VIEW -->
            <div class="page-header">
                <h1>Material Out</h1>
                <div class="header-actions">
                    <button type="button" @onclick="OpenCreate" disabled="@busy">Alt+C Create</button>
                    <button type="button" @onclick="() => OpenSelectedAsync()" disabled="@(busy || selectedIndex < 0)">Enter Alter</button>
                    <button type="button" @onclick="PromptDeleteSelected" disabled="@(busy || selectedIndex < 0)">Alt+D Delete</button>
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(message)) { <div class="form-message list-message @(messageIsError ? "error" : "success")">@message</div> }

            <div class="list-toolbar">
                <label>F4 Search: <input id="mo-search" placeholder="Search Material Out..." value="@searchText"
                                         @oninput="SearchTextChanged" @onkeydown="HandleSearchKeyDown" @onkeydown:stopPropagation="true" /></label>
                <button type="button" @onclick="ApplySearchAsync" disabled="@busy">Search</button>
                <button type="button" @onclick="ClearSearchAsync" disabled="@(busy || string.IsNullOrWhiteSpace(searchText))">Clear</button>
            </div>

            <div id="mo-grid" class="mo-list-grid">
                <table>
                    <thead><tr>
                        <th>VOUCHER NO.</th><th>DATE</th><th>PARTY A/C NAME</th><th>JWO / ORDER NO.</th>
                        <th>BATCH</th><th>JOBBER DESTINATION GODOWN</th><th class="number-column">QUANTITY</th>
                        <th class="number-column">AMOUNT</th><th>STATUS</th>
                    </tr></thead>
                    <tbody>
                    @if (rows.Count == 0)
                    {
                        <tr><td colspan="9" class="empty-row" style="text-align:center;">No Material Out vouchers found. Press Alt+C to create.</td></tr>
                    }
                    else
                    {
                        @for (var i = 0; i < rows.Count; i++)
                        {
                            var index = i; var row = rows[index];
                            <tr id="mo-row-@row.Id" class="@(selectedIndex == index ? "selected" : null)" @onclick="() => SelectListRow(index)" @ondblclick="() => OpenSelectedAsync()">
                                <td><strong>@row.VoucherNumber</strong></td><td>@row.VoucherDate.ToString("dd-MM-yyyy")</td>
                                <td>@row.JobWorkerName</td><td>@row.DisplayedOrderNumber</td><td>@row.Batch</td>
                                <td>@row.DestinationGodownName</td><td class="number-column">@row.TotalQuantity.ToString("0.####")</td>
                                <td class="number-column">@row.TotalAmount.ToString("0.00")</td><td>@row.Status</td>
                            </tr>
                        }
                    }
                    </tbody>
                </table>
            </div>
            <div class="grid-key-hint">↑/↓ Select · Enter Alter · PgUp/PgDn Jump · Home/End · Alt+C Create · Alt+D Delete · Esc Back</div>
        }
        else
        {
            <!-- FORM VIEW -->
            <KeyboardContextScope ContextId="material-out-form" RootElementId="mo-form-root"
                                  ContextType="KeyboardContextType.Form"
                                  Mode="@(editingVoucherId is null ? KeyboardContextMode.Create : KeyboardContextMode.Alteration)"
                                  CanDelete="@(editingVoucherId is not null && !busy)" DeleteAsync="PromptDeleteCurrent"
                                  CanCancel="@(editingVoucherId is not null && !isCancelledVoucher && !busy)" CancelAsync="PromptCancelCurrent"
                                  IsVoucherEntry="true" EscapeAsync="HandleVoucherEscapeAsync" AcceptAsync="SaveVoucherAsync" />
            <section id="mo-form-root" class="mo-entry-form tt-voucher-entry" data-voucher-profile="material-out" tabindex="0" data-enter-navigation="true" data-tt-voucher-form-root="true">

                <header class="mo-form-heading">
                    <strong>Material Out</strong>
                    <div class="mo-context-date">
                        <VoucherDateInput Id="mo-date" Class="mo-header-date-input" @bind-Value="defaults.VoucherDate" Disabled="@(isCancelledVoucher && !DeveloperAccess.IsDeveloper)" />
                        <span>@defaults.VoucherDate.ToString("dddd")</span>
                    </div>
                </header>

                @if (!string.IsNullOrWhiteSpace(message)) { <div class="form-message @(messageIsError ? "error" : "success")">@message</div> }

                <section class="tally-master-fields">
                    <div class="tally-col">
                        <div class="tally-field wide-field">
                            <span>Party A/c Name <b>*</b></span>
                            <div class="lookup-field">
                                <input @ref="partyInput" id="mo-job-worker" data-erp-lookup="true" data-tt-related-master="/masters/ledgers" autocomplete="new-password" name="mo-job-worker-lookup"
                                       data-enter-empty-action="mo-job-worker-first-option"
                                       readonly="@(editingVoucherId is not null)"
                                       aria-label="Party A/c Name" placeholder="Type to search Job Worker" value="@jobWorkerText"
                                       @onfocus="OpenJobWorkerLookup" @oninput="JobWorkerTextChanged" @onchange="JobWorkerTextCommitted"
                                       @onkeydown="HandlePartyKeyDown" @onkeydown:stopPropagation="true" />
                                @if (activeLookupKey == "job-worker")
                                {
                                    var workers = FilterJobWorkers().Take(12).ToList();
                                    <div class="erp-lookup-panel">
                                        @for (var wIdx = 0; wIdx < workers.Count; wIdx++)
                                        {
                                            var worker = workers[wIdx];
                                            var isSelected = wIdx == workerLookupIndex;
                                            <button id="@(wIdx == 0 ? "mo-job-worker-first-option" : null)" type="button" tabindex="-1" class="@(isSelected ? "lookup-selected" : null)"
                                                    @onmousedown="IgnoreMouseDown" @onmousedown:preventDefault="true" 
                                                    @onclick="() => SelectJobWorker(worker)">
                                                <strong>@worker.Name</strong><span>@worker.GroupName</span>
                                            </button>
                                        }
                                        @if (workers.Count == 0) { <div class="erp-lookup-empty">No matching Job Worker</div> }
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="tally-field compact-field">
                            <span>JWO / Order No. <b>*</b></span>
                            <div class="lookup-field">
                                <input id="mo-order-number" data-erp-lookup="true" autocomplete="new-password" name="mo-order-number-lookup"
                                       data-enter-empty-action="mo-order-first-option"
                                       readonly="@(editingVoucherId is not null)"
                                       aria-label="JWO / Order No." maxlength="100" placeholder="Select pending JWO" value="@orderNumberText"
                                       @onfocus="OpenOrderLookup" @oninput="OrderTextChanged" @onkeydown="HandleOrderKeyDown" @onkeydown:stopPropagation="true" />
                                @if (activeLookupKey == "order")
                                {
                                    var pendingOrders = FilterOrders().Take(15).ToList();
                                    <div class="erp-lookup-panel mo-order-lookup-panel">
                                        @if (pendingOrders.Count == 0) { <div class="erp-lookup-empty">No pending JWO found for this Job Worker</div> }
                                        else
                                        {
                                            <div class="mo-order-lookup-head">
                                                <span>Order No.</span><span>Date</span><span>Batch</span><span style="text-align:right;">Pending</span>
                                            </div>
                                            @for (var oIdx = 0; oIdx < pendingOrders.Count; oIdx++)
                                            {
                                                var order = pendingOrders[oIdx];
                                                var orderIndex = orders.IndexOf(order);
                                                var isSelected = oIdx == orderLookupIndex;
                                                <button id="@(oIdx == 0 ? "mo-order-first-option" : null)" type="button" tabindex="-1" class="mo-order-option @(isSelected ? "lookup-selected" : null)"
                                                        @onmousedown="IgnoreMouseDown" @onmousedown:preventDefault="true" 
                                                        @onclick="() => SelectOrder(orderIndex)">
                                                    <strong>@order.VoucherNumber</strong>
                                                    <span>@order.VoucherDate.ToString("dd-MM-yyyy")</span>
                                                    <span>@order.Batch</span>
                                                    <span style="text-align:right;">@FormatQuantity(order.TotalPendingQuantity, GetOrderDecimalPlaces(order))</span>
                                                </button>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="tally-field compact-field">
                            <span>Jobber Destination Godown</span>
                            <div class="lookup-field">
                                <input id="mo-destination" data-erp-lookup="true" data-tt-related-master="/masters/godowns" autocomplete="new-password" name="mo-destination-lookup"
                                       aria-label="Jobber Destination Godown" placeholder="Select Jobber Destination Godown" @bind:get="destinationGodownText" @bind:set="DestinationGodownTextChanged" @bind:event="oninput"
                                       @onfocus="OpenDestinationGodownLookup" @onchange="DestinationGodownTextCommitted" />
                                @if (activeLookupKey == "destination-godown")
                                {
                                    <div class="erp-lookup-panel">
                                        @foreach (var godown in FilterGodowns().Take(12))
                                        {
                                            <button type="button" tabindex="-1" @onmousedown="IgnoreMouseDown" @onmousedown:preventDefault="true" @onclick="() => SelectDestinationGodown(godown)"><strong>@godown.Name</strong></button>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="tally-col">
                        <label class="tally-field" style="width: 250px;">
                            <span>Voucher No.</span>
                            <input id="mo-voucher-number" readonly="@(editingVoucherId is not null || defaults.NumberingMode != "Manual")"
                                   tabindex="@(editingVoucherId is null && defaults.NumberingMode == "Manual" ? 0 : -1)" @bind="defaults.VoucherNumber" />
                        </label>
                        <label class="tally-field" style="width: 250px;">
                            <span>Batch</span>
                            <input id="mo-batch" maxlength="100" @bind="batchText" @bind:event="oninput" />
                        </label>
                        <label class="tally-field" style="width: 250px;">
                            <span>Reference</span>
                            <input id="mo-reference" maxlength="100" @bind="defaults.ReferenceNumber" @bind:event="oninput" />
                        </label>
                    </div>
                </section>

                <div class="mo-lines-workspace">
                    <div class="tally-grid">
                        <table>
                            <thead>
                                <tr>
                                    <th>Name of Item (Component)</th>
                                    <th>Material Source Godown</th>
                                    <th class="number-column">Stock in Hand</th>
                                    <th class="number-column">Pending</th>
                                    <th class="number-column" style="width: 120px;">Issue Qty</th>
                                    <th>UQC</th>
                                    <th class="number-column" style="width: 100px;">Rate</th>
                                    <th class="number-column">Amount</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (selectedOrder is null)
                                {
                                    <tr><td colspan="8" class="empty-cell">Select Party A/c Name, then choose a pending JWO from the JWO / Order No. field.</td></tr>
                                }
                                else
                                {
                                    @foreach (var fg in selectedOrder.FinishedGoods)
                                    {
                                        <tr class="mo-fg-row">
                                            <td colspan="8">
                                                <strong>@fg.FinishedGoodName</strong>
                                                <span>Ordered @FormatQuantity(fg.OrderedQuantity, GetFinishedGoodDecimalPlaces(fg)) · Finished Goods Godown @fg.FinishedGoodsGodownName</span>
                                            </td>
                                        </tr>
                                        @foreach (var line in fg.Components)
                                        {
                                            var inputId = $"mo-qty-{line.JwoComponentId}";
                                            <tr>
                                                <td>@line.StockItemName</td>
                                                <td>@line.SourceGodownName</td>
                                                <td class="number-column" style="color: #0f172a !important;" title="@(line.SourceGodownId is null ? "No source godown selected" : $"As on {defaults.VoucherDate:dd-MMM-yyyy}")">
                                                    @(line.SourceGodownId is null ? "—" : stockInHand.TryGetValue(line.JwoComponentId, out var onHand) ? FormatQuantity(onHand, line.DecimalPlaces) : "…")
                                                </td>
                                                <td class="number-column" style="color: #0f172a !important;">@FormatQuantity(line.PendingQuantity, line.DecimalPlaces)</td>
                                                <td>
                                                    <input id="@inputId" type="text" inputmode="decimal" value="@GetQuantityText(line)"
                                                           onfocus="this.select()" @oninput="@(e => HandleQuantityInput(e, line))"
                                                           @onblur="@(_ => NormalizeQuantityText(line))" @onkeydown="@(e => HandleQuantityKeyDown(e, line))" @onkeydown:stopPropagation="true" />
                                                </td>
                                                <td class="text-center" style="font-weight:bold; color:#0f172a;">@line.UqcShortName</td>
                                                <td>
                                                    <input id="@($"mo-rate-{line.JwoComponentId}")" type="text" inputmode="decimal" value="@GetRateText(line)"
                                                           onfocus="this.select()" @oninput="@(e => HandleRateInput(e, line))"
                                                           readonly="@line.IsProducedComponent"
                                                           title="@(line.IsProducedComponent ? "Derived from the remaining value received from the earlier production stage." : "Enter the material rate.")"
                                                           @onblur="@(_ => NormalizeRateText(line))" @onkeydown="@(e => HandleRateKeyDown(e, line))" @onkeydown:stopPropagation="true" />
                                                </td>
                                                <td class="number-column">@line.Amount.ToString("0.00")</td>
                                            </tr>
                                        }
                                    }
                                }
                            </tbody>
                            @if (selectedOrder is not null)
                            {
                                <tfoot>
                                    <tr>
                                        <td colspan="3" style="text-align:right; font-weight:bold; padding-right:15px; color:#0f172a;">TOTAL:</td>
                                        <td class="number-column">@FormatTotalQuantity()</td>
                                        <td colspan="2"></td>
                                        <td class="number-column">@TotalAmount.ToString("0.00")</td>
                                    </tr>
                                </tfoot>
                            }
                        </table>
                    </div>
                </div>

                <div class="mo-footer-fields">
                    <label style="width: 250px; flex: none;">
                        Provide GST/e-Way Bill details
                        <select id="mo-gst-eway" value="@gstEwayBillDetails" @onchange="GstEwaySelectionChanged">
                            <option value="No">No</option>
                            <option value="Yes">Yes</option>
                        </select>
                    </label>
                    <label>
                        Narration
                        <textarea id="mo-narration" rows="2" @bind="narration" @bind:event="oninput"></textarea>
                    </label>
                </div>

                @if (editingVoucherId is long auditVoucherId)
                {
                    <VoucherAuditStamp VoucherId="@auditVoucherId" />
                }
                <VoucherActionBar Class="mo-save-actions" Note="Material Out permanently impacts Stock values and cannot be edited if partially consumed.">
                    
                    @if (editingVoucherId is null)
                    {
                        <button type="button" class="compact-action action-secondary" disabled="@busy" @onclick="ClearSelection">Clear Order</button>
                    }
                    @if (editingVoucherId is not null && !isCancelledVoucher)
                    {
                        <button type="button" class="compact-action action-danger" disabled="@busy" @onclick="PromptDeleteCurrent">Alt+D Delete</button>
                        <button type="button" class="compact-action action-danger" disabled="@busy" @onclick="PromptCancelCurrent">Alt+X Cancel</button>
                    }

                    <button type="button" class="compact-action action-secondary" @onclick="HandleVoucherEscapeAsync" disabled="@busy">Esc Back</button>
                    <button id="mo-save" type="button" class="compact-action action-save" data-enter-save="true" data-voucher-save-action="true" disabled="@(busy || isCancelledVoucher && !DeveloperAccess.IsDeveloper)" @onclick="SaveVoucherAsync">@(busy ? "Saving…" : editingVoucherId is null ? "Alt+A Accept (Save)" : "Alt+A Update")</button>
                </VoucherActionBar>

            </section>
        }
    }
</div>

<!-- E-WAY BILL MODAL -->
@if (showEwayDetailsModal)
{
    <div class="tally-modal-overlay" @onkeydown="HandleEwayModalKeyDown" @onkeydown:preventDefault="true" @onkeydown:stopPropagation="true">
        <section class="tally-modal-window" role="dialog" aria-modal="true" aria-labelledby="mo-eway-title" tabindex="0" @ref="ewayModalRoot">
            <header class="tally-modal-titlebar">
                <strong id="mo-eway-title">GST/e-Way Bill Additional Details</strong>
                <span>Enter Next · Esc Return · Alt+A Save</span>
            </header>

            <div class="mo-eway-body" data-enter-navigation="true">
                <section class="mo-eway-section">
                    <h3>e-Way Bill Details</h3>
                    <div class="mo-eway-grid two-column">
                        <label>e-Way Bill No.<input id="mo-eway-number" @bind="ewayBillNumber" @bind:event="oninput" /></label>
                        <label>e-Way Bill Date<FlexibleDateInput @bind-Value="ewayBillDate" BasisDate="defaults.VoucherDate" /></label>
                        <label>Consolidated e-Way Bill No.<input @bind="consolidatedEwayBillNumber" @bind:event="oninput" /></label>
                        <label>Consolidated Date<FlexibleDateInput @bind-Value="consolidatedEwayBillDate" BasisDate="defaults.VoucherDate" /></label>
                        <label>Sub Type
                            <select @bind="ewaySubType"><option>Others</option><option>Supply</option><option>Job Work</option><option>For Own Use</option></select>
                        </label>
                        <label>Document Type
                            <select @bind="ewayDocumentType"><option>Delivery Challan</option><option>Tax Invoice</option><option>Bill of Supply</option><option>Others</option></select>
                        </label>
                    </div>
                </section>

                <div class="mo-eway-party-columns">
                    <section class="mo-eway-section">
                        <h3>Consignor Details (From)</h3>
                        <div class="mo-eway-grid">
                            <label>Mailing Name<input @bind="consignorMailingName" /></label>
                            <label>GSTIN/UIN<input @bind="consignorGstin" /></label>
                            <label>State<input @bind="consignorState" /></label>
                            <label>Address 1<input @bind="consignorAddress1" /></label>
                            <label>Address 2<input @bind="consignorAddress2" /></label>
                            <label>Pincode<input @bind="consignorPincode" /></label>
                            <label>Place<input @bind="consignorPlace" /></label>
                            <label>Actual State<input @bind="consignorActualState" /></label>
                        </div>
                    </section>
                    <section class="mo-eway-section">
                        <h3>Consignee Details (To)</h3>
                        <div class="mo-eway-grid">
                            <label>Mailing Name<input @bind="consigneeMailingName" /></label>
                            <label>GSTIN/UIN<input @bind="consigneeGstin" /></label>
                            <label>State<input @bind="consigneeState" /></label>
                            <label>Address 1<input @bind="consigneeAddress1" /></label>
                            <label>Address 2<input @bind="consigneeAddress2" /></label>
                            <label>Pincode<input @bind="consigneePincode" /></label>
                            <label>Place<input @bind="consigneePlace" /></label>
                            <label>Actual State<input @bind="consigneeActualState" /></label>
                        </div>
                    </section>
                </div>

                <section class="mo-eway-section">
                    <h3>Transport and Part B Details</h3>
                    <div class="mo-eway-grid two-column">
                        <label>Pin-to-Pin Distance<input inputmode="numeric" @bind="pinToPinDistance" /></label>
                        <label>Transporter Name<input @bind="transporterName" /></label>
                        <label>Transporter ID<input @bind="transporterId" /></label>
                        <label>Mode<select @bind="transportMode"><option>Not Applicable</option><option>Road</option><option>Rail</option><option>Air</option><option>Ship</option></select></label>
                        <label>Doc/Lading/RR/AirWay No.<input @bind="transportDocumentNumber" /></label>
                        <label>Document Date<FlexibleDateInput @bind-Value="transportDocumentDate" BasisDate="defaults.VoucherDate" /></label>
                        <label>Vehicle Number<input @bind="vehicleNumber" /></label>
                        <label>Vehicle Type<select @bind="vehicleType"><option>Not Applicable</option><option>Regular</option><option>Over Dimensional Cargo</option></select></label>
                    </div>
                </section>
            </div>

            <footer class="tt-dialog-actions">
                <button type="button" class="compact-action action-secondary" disabled="@busy" @onclick="CloseEwayDetails">Esc Return</button>
                <button type="button" class="compact-action action-secondary" disabled="@busy" @onclick="AcceptEwayDetails">Accept Details</button>
                <button type="button" class="compact-action action-save" disabled="@busy" @onclick="SaveFromEwayAsync">@(busy ? "Saving…" : "Alt+A Save Voucher")</button>
            </footer>
        </section>
    </div>
}

<!-- EXIT MODALS -->
@if (showExitModal)
{
    <div class="tt-dialog-overlay" role="presentation">
        <section class="tt-dialog" role="dialog" aria-modal="true" aria-labelledby="mo-exit-title" tabindex="0" @ref="exitModalRoot"
                 @onkeydown="HandleExitModalKeyDown" @onkeydown:stopPropagation="true" @onkeydown:preventDefault="true">
            <header class="tt-dialog-titlebar"><strong id="mo-exit-title">Quit?</strong></header>
            <div class="tt-dialog-body"><p>Quit? Yes or No</p></div>
            <footer class="tt-dialog-actions">
                <button id="mo-exit-yes" type="button" class="@(exitModalSelectYes ? "dialog-selected" : null)" @onclick="ConfirmExitVoucher">Yes</button>
                <button id="mo-exit-no" type="button" class="@(!exitModalSelectYes ? "dialog-selected" : null)" @onclick="CancelExitVoucher">No</button>
            </footer>
        </section>
    </div>
}

@if (showDeleteModal)
{
    <div class="tally-modal-overlay" role="presentation">
        <section class="tally-modal-window" role="dialog" aria-modal="true" aria-labelledby="mo-delete-title" tabindex="0" style="width: 450px; min-height: auto;"
                 @onkeydown="HandleDeleteModalKeyDown" @onkeydown:stopPropagation="true" @onkeydown:preventDefault="true">
            <header class="tally-modal-titlebar"><strong id="mo-delete-title">Delete Material Out?</strong></header>
            <div class="tt-dialog-body" style="padding: 15px; color:#0f172a;">
                <p>This is allowed only when the voucher has no linked Material In or other dependency.</p>
                <p><strong>@currentActionVoucherNumber</strong></p>
                @if (!string.IsNullOrWhiteSpace(actionMessage)) { <div class="form-message error">@actionMessage</div> }
            </div>
            <footer class="tt-dialog-actions">
                <button id="mo-delete-yes" type="button" class="compact-action action-danger" @onclick="ConfirmDeleteAsync">Yes</button>
                <button id="mo-delete-no" type="button" class="compact-action action-secondary" @onclick="CloseDeleteModal">No</button>
            </footer>
        </section>
    </div>
}

@if (showCancelModal)
{
    <div class="tally-modal-overlay" role="presentation">
        <section class="tally-modal-window" role="dialog" aria-modal="true" aria-labelledby="mo-cancel-title" tabindex="0" style="width: 500px; min-height: auto;"
                 @onkeydown="HandleCancelModalKeyDown" @onkeydown:stopPropagation="true">
            <header class="tally-modal-titlebar"><strong id="mo-cancel-title">Cancel Material Out?</strong></header>
            <div class="tt-dialog-body" style="padding: 15px; color:#0f172a;">
                <p>The voucher will remain in history and its stock effect will be reversed.</p>
                <p><strong>@currentActionVoucherNumber</strong></p>
                <label style="display:flex; flex-direction:column; gap:4px; font-weight:bold; font-size:12px; margin-top:10px; color:#0f172a;">Cancellation Reason <b>*</b>
                    <textarea id="mo-cancel-reason" maxlength="500" rows="3" @bind="cancellationReason" @bind:event="oninput" style="border:1px solid #cbd5e1; padding:5px; color:#0f172a;"></textarea>
                </label>
                @if (!string.IsNullOrWhiteSpace(actionMessage)) { <div class="form-message error">@actionMessage</div> }
            </div>
            <footer class="tt-dialog-actions">
                <button type="button" class="compact-action action-danger" @onclick="ConfirmCancelAsync">Cancel Voucher</button>
                <button type="button" class="compact-action action-secondary" @onclick="CloseCancelModal">Return</button>
            </footer>
        </section>
    </div>
}

@code {
    [SupplyParameterFromQuery(Name = "voucherId")] public long? VoucherId { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }
    private ElementReference pageRoot;
    private ElementReference exitModalRoot;
