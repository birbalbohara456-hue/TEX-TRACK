    protected override async Task OnInitializedAsync()
    {
        if (Database.IsConnected)
        {
            lookup = await Repository.GetLookupDataAsync();
            defaults = await Repository.GetEntryDefaultsAsync();
            if (VoucherId is not null) await OpenSelectedAsync(VoucherId.Value);
            else await OpenCreate();
        }
        loading = false;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            relatedMasterRefreshReference = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("texTrackRegisterRelatedMasterRefresh", relatedMasterRefreshReference);
            await pageRoot.FocusAsync();
        }
        if (showExitModal)
        {
            await exitModalRoot.FocusAsync();
            return;
        }
        if (showEwayDetailsModal)
        {
            await JS.InvokeVoidAsync("texTrackFocusById", "mo-eway-number");
            return;
        }

        // 🔴 FIX: ONLY FOCUS SPECIFICALLY REQUESTED TARGETS (NO INFINITE FOCUS LOOP)
        if (!string.IsNullOrWhiteSpace(pendingFocusId))
        {
            var id = pendingFocusId;
            pendingFocusId = null;
            await Task.Delay(40);

            if (id == "mo-job-worker")
            {
                try { await partyInput.FocusAsync(); } catch { }
            }
            else
            {
                await JS.InvokeVoidAsync("texTrackFocusById", id);
            }
        }
        
        if (pendingRowScroll && selectedIndex >= 0 && selectedIndex < rows.Count)
        {
            pendingRowScroll = false;
            await JS.InvokeVoidAsync("texTrackScrollRowIntoView", $"mo-row-{rows[selectedIndex].Id}", "mo-grid");
        }
    }

    [JSInvokable]
    public async Task RefreshRelatedMasterLookupsAsync(string returnFocusId)
    {
        lookup = await Repository.GetLookupDataAsync();
        pendingFocusId = string.IsNullOrWhiteSpace(returnFocusId) ? "mo-job-worker" : returnFocusId;
        await InvokeAsync(StateHasChanged);
    }

    // Reuses the same registered reference as RefreshRelatedMasterLookupsAsync above -
    // called by the shared closeLookupOnBlur JS whenever a data-erp-lookup field loses
    // focus with its dropdown open, so activeLookupKey genuinely clears server-side
    // instead of relying only on the client-side hide, which a later unrelated
    // re-render would otherwise undo (see JobWorkOutOrder.razor's identical handler for
    // the full explanation). Only clears when it still matches the exact field that
    // blurred.
    [JSInvokable]
    public Task ClearLookupOnBlurAsync(string fieldId)
    {
        var key = fieldId switch
        {
            "mo-job-worker" => "job-worker",
            "mo-order-number" => "order",
            "mo-destination" => "destination-godown",
            _ => null
        };
        if (key is not null && activeLookupKey == key)
        {
            activeLookupKey = null;
            StateHasChanged();
        }
        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        if (relatedMasterRefreshReference is not null)
        {
            try { await JS.InvokeVoidAsync("texTrackUnregisterRelatedMasterRefresh", relatedMasterRefreshReference); }
            catch (JSDisconnectedException) { }
            catch (InvalidOperationException) { }
        }
        relatedMasterRefreshReference?.Dispose();
    }

    private async Task LoadListAsync(long? selectId = null)
    {
        rows = (await Repository.GetListAsync(searchText)).ToList();
        if (rows.Count == 0) selectedIndex = -1;
        else if (selectId is not null)
        {
            selectedIndex = rows.FindIndex(x => x.Id == selectId.Value);
            if (selectedIndex < 0) selectedIndex = 0;
        }
        else if (selectedIndex < 0 || selectedIndex >= rows.Count) selectedIndex = 0;
        pendingRowScroll = selectedIndex >= 0;
    }

    private async Task OpenCreate()
    {
        if (busy) return;
        editingVoucherId = null;
        editingConcurrencyToken = string.Empty;
        isCancelledVoucher = false;
        defaults = await Repository.GetEntryDefaultsAsync();
        await ResetAfterSaveAsync();
        showForm = true;
        message = string.Empty;
        pendingFocusId = defaults.NumberingMode == "Manual" ? "mo-voucher-number" : "mo-job-worker";
    }

    private async Task OpenSelectedAsync(long? requestedVoucherId = null)
    {
        if (busy) return;
        var voucherId = requestedVoucherId ?? (selectedIndex >= 0 && selectedIndex < rows.Count ? rows[selectedIndex].Id : 0);
        if (voucherId == 0) return;
        busy = true;
        try
        {
            var data = await Repository.GetForEditAsync(voucherId);
            if (data is null)
            {
                message = "The selected Material Out voucher could not be loaded.";
                messageIsError = true;
                return;
            }

            editingVoucherId = data.VoucherId;
            editingConcurrencyToken = data.ConcurrencyToken;
            isCancelledVoucher = string.Equals(data.Status, "Cancelled", StringComparison.OrdinalIgnoreCase);
            defaults = data.Defaults;
            selectedJobWorkerId = data.JobWorkerLedgerId;
            jobWorkerText = data.JobWorkerName;
            destinationGodownId = data.DestinationGodownId;
            destinationGodownText = data.DestinationGodownName;
            batchText = data.Batch;
            narration = data.Narration;
            selectedOrder = data.Order;
            orders = new List<MaterialOutPendingOrder> { data.Order };
            orderNumberText = data.Order.VoucherNumber;
            gstEwayBillDetails = data.ProvideGstEwayDetails ? "Yes" : "No";
            ApplyEwayDetails(data.EwayDetails);
            quantityText.Clear();
            rateText.Clear();
            foreach (var line in SelectedLines)
            {
                quantityText[line.JwoComponentId] = FormatQuantity(line.IssueNowQuantity, line.DecimalPlaces);
                rateText[line.JwoComponentId] = line.Rate.ToString("0.00", CultureInfo.InvariantCulture);
            }
            await LoadStockPositionsAsync();
            showForm = true;
            activeLookupKey = null;
            message = isCancelledVoucher
                ? $"Material Out {defaults.VoucherNumber} is cancelled and is available for audit view only."
                : $"Material Out {defaults.VoucherNumber} opened in alteration mode.";
            messageIsError = false;
            pendingFocusId = isCancelledVoucher && !DeveloperAccess.IsDeveloper ? "mo-page-root" : "mo-job-worker";
        }
        catch (Exception ex)
        {
            message = VoucherErrorMessages.For(ex);
            messageIsError = true;
        }
        finally { busy = false; }
    }

