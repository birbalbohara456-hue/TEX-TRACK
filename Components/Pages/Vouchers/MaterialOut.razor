    private static string GetValidationFocusId(string validationMessage)
    {
        if (validationMessage.Contains("Party", StringComparison.OrdinalIgnoreCase)) return "mo-job-worker";
        if (validationMessage.Contains("JWO", StringComparison.OrdinalIgnoreCase)) return "mo-order-number";
        if (validationMessage.Contains("Destination", StringComparison.OrdinalIgnoreCase)) return "mo-destination";
        if (validationMessage.Contains("Voucher Number", StringComparison.OrdinalIgnoreCase)) return "mo-voucher-number";
        return "mo-save";
    }

