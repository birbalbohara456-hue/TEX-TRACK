    private async Task HandlePageKeyDown(KeyboardEventArgs e)
    {
        if (showExitModal || showEwayDetailsModal || showDeleteModal || showCancelModal) return;
        if (!showForm)
        {
            if (e.Key == "F4")
            {
                pendingFocusId = "mo-search";
                return;
            }
            if (e.AltKey && string.Equals(e.Key, "c", StringComparison.OrdinalIgnoreCase))
            {
                await OpenCreate();
                return;
            }
            if (e.Key == "Enter")
            {
                await OpenSelectedAsync();
                return;
            }
            if (rows.Count > 0)
            {
                var changed = false;
                if (e.Key is "ArrowDown" or "Down") { selectedIndex = Math.Min(selectedIndex + 1, rows.Count - 1); changed = true; }
                else if (e.Key is "ArrowUp" or "Up") { selectedIndex = Math.Max(selectedIndex - 1, 0); changed = true; }
                else if (e.Key == "PageDown") { selectedIndex = Math.Min(selectedIndex + 10, rows.Count - 1); changed = true; }
                else if (e.Key == "PageUp") { selectedIndex = Math.Max(selectedIndex - 10, 0); changed = true; }
                else if (e.Key == "Home") { selectedIndex = 0; changed = true; }
                else if (e.Key == "End") { selectedIndex = rows.Count - 1; changed = true; }
                if (changed) { pendingRowScroll = true; return; }
            }
            if (e.Key == "Escape") Navigation.NavigateTo("/");
            return;
        }
        if (e.AltKey && string.Equals(e.Key, "x", StringComparison.OrdinalIgnoreCase) && editingVoucherId is not null && !isCancelledVoucher)
        {
            PromptCancelCurrent();
            return;
        }
        if (e.AltKey && string.Equals(e.Key, "a", StringComparison.OrdinalIgnoreCase))
        {
            await SaveVoucherAsync();
            return;
        }
        if (e.Key == "Escape") await HandleVoucherEscapeAsync();
    }

