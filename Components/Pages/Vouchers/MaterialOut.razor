    private async Task LoadPendingAsync()
    {
        if (selectedJobWorkerId is null || busy) return;
        var alterationOrder = editingVoucherId is not null ? selectedOrder : null;
        pendingFocusId = "mo-order-number";
        busy = true;
        try
        {
            orders = (await Repository.GetPendingOrdersAsync(selectedJobWorkerId.Value)).ToList();
            if (alterationOrder is not null)
            {
                if (orders.All(x => x.JwoVoucherId != alterationOrder.JwoVoucherId))
                    orders.Insert(0, alterationOrder);
                selectedOrder = alterationOrder;
                orderNumberText = alterationOrder.VoucherNumber;
                batchText = alterationOrder.Batch;
            }
            else
            {
                selectedOrder = null;
                orderNumberText = string.Empty;
            }
            quantityText.Clear();
            activeLookupKey = alterationOrder is null ? "order" : null;
            orderLookupIndex = -1;
            message = alterationOrder is not null
                ? $"JWO {alterationOrder.VoucherNumber} retained for this Material Out alteration."
                : orders.Count == 0 ? "No pending JWO components were found for the selected Job Worker." : $"{orders.Count} pending JWO(s) found. Select an order from JWO / Order No.";
            messageIsError = orders.Count == 0;
            pendingFocusId = "mo-order-number";
        }
        catch (Exception ex)
        {
            message = VoucherErrorMessages.For(ex);
            messageIsError = true;
        }
        finally { busy = false; }
    }

    private async Task SelectOrder(int index)
    {
        // JWO / Order No. is immutable during alteration - see OpenOrderLookup.
        if (editingVoucherId is not null) return;
        if (index < 0 || index >= orders.Count) return;
        selectedOrder = orders[index];
        orderNumberText = selectedOrder.VoucherNumber;
        batchText = selectedOrder.Batch;
        defaults.ReferenceNumber = string.IsNullOrWhiteSpace(selectedOrder.ReferenceNumber)
            ? selectedOrder.VoucherNumber
            : selectedOrder.ReferenceNumber;
        if (destinationGodownId is null)
        {
            destinationGodownText = selectedOrder.FinishedGoods
                .Select(x => x.DestinationGodownName)
                .FirstOrDefault(x => !string.IsNullOrWhiteSpace(x)) ?? string.Empty;
            destinationGodownId = lookup.Godowns
                .FirstOrDefault(x => string.Equals(x.Name, destinationGodownText, StringComparison.OrdinalIgnoreCase))?.Id;
        }
        quantityText.Clear();
        rateText.Clear();
        foreach (var line in SelectedLines)
        {
            line.IssueNowQuantity = line.PendingQuantity;
            quantityText[line.JwoComponentId] = FormatQuantity(line.IssueNowQuantity, line.DecimalPlaces);
            rateText[line.JwoComponentId] = line.Rate.ToString("0.00", CultureInfo.InvariantCulture);
        }
        await LoadStockPositionsAsync();
        activeLookupKey = null; // 🔴 CLOSE LOOKUP IMMEDIATELY ON SELECTION
        orderLookupIndex = -1;
        message = $"JWO {selectedOrder.VoucherNumber} loaded. Review or edit Issue Quantity.";
        messageIsError = false;
        pendingFocusId = SelectedLines.Select(x => $"mo-qty-{x.JwoComponentId}").FirstOrDefault() ?? "mo-narration";
    }

    private void ClearSelection()
    {
        selectedOrder = null;
        orders.Clear();
        orderNumberText = string.Empty;
        batchText = string.Empty;
        destinationGodownId = null;
        destinationGodownText = string.Empty;
        quantityText.Clear();
        rateText.Clear();
        stockInHand.Clear();
        activeLookupKey = null;
        message = string.Empty;
        pendingFocusId = "mo-job-worker";
    }

    // Fetches the exact stock-on-hand quantity per line from the shared stock-position
    // service (company + item + variant + UQC + godown + as-on date), one call per
    // component - never by scraping a report. StockPositionService matches the
    // variant exactly (including null), so a component tied to a specific colour/size
    // variant must pass that variant id through or it will read as zero.
    private async Task LoadStockPositionsAsync()
    {
        stockInHand.Clear();
        var lines = SelectedLines.Where(x => x.SourceGodownId is not null).ToList();
        if (lines.Count == 0) return;
        foreach (var line in lines)
        {
            try
            {
                var snapshot = await StockPosition.GetAsync(new StockPositionRequest(
                    line.StockItemId, line.StockItemVariantId, line.UqcId, line.SourceGodownId!.Value, defaults.VoucherDate));
                stockInHand[line.JwoComponentId] = snapshot.Quantity;
            }
            catch (InvalidOperationException)
            {
                // A master referenced by this line is no longer valid for the current
                // company; leave it out of stockInHand so the cell shows "..." rather than
                // a stale or wrong figure.
            }
        }
        StateHasChanged();
    }

    private string GetQuantityText(MaterialOutPendingComponent line)
    {
        if (quantityText.TryGetValue(line.JwoComponentId, out var value)) return value;
        value = FormatQuantity(line.IssueNowQuantity, line.DecimalPlaces);
        quantityText[line.JwoComponentId] = value;
        return value;
    }

    private void HandleQuantityInput(ChangeEventArgs e, MaterialOutPendingComponent line)
    {
        var text = e.Value?.ToString() ?? string.Empty;
        quantityText[line.JwoComponentId] = text;
        if (TryParseQuantity(text, out var value))
            line.IssueNowQuantity = Math.Clamp(value, 0, line.PendingQuantity);
    }

    private void NormalizeQuantityText(MaterialOutPendingComponent line)
    {
        if (!quantityText.TryGetValue(line.JwoComponentId, out var text) || !TryParseQuantity(text, out var value))
            value = line.IssueNowQuantity;
        line.IssueNowQuantity = Math.Clamp(value, 0, line.PendingQuantity);
        quantityText[line.JwoComponentId] = FormatQuantity(line.IssueNowQuantity, line.DecimalPlaces);
    }

    private static bool TryParseQuantity(string text, out decimal value)
    {
        var normalized = (text ?? string.Empty).Trim().Replace(',', '.');
        return decimal.TryParse(normalized, NumberStyles.AllowDecimalPoint | NumberStyles.AllowLeadingSign, CultureInfo.InvariantCulture, out value);
    }

    private void HandleQuantityKeyDown(KeyboardEventArgs e, MaterialOutPendingComponent current)
    {
        if (e.Key == "Escape") { pendingFocusId = "mo-order-number"; return; }
        if (e.Key != "Enter") return;
        NormalizeQuantityText(current);
        var lines = SelectedLines.ToList();
        var index = lines.FindIndex(x => x.JwoComponentId == current.JwoComponentId);
        pendingFocusId = current.IsProducedComponent
            ? (index >= 0 && index + 1 < lines.Count ? $"mo-qty-{lines[index + 1].JwoComponentId}" : "mo-gst-eway")
            : $"mo-rate-{current.JwoComponentId}";
    }

    private string GetRateText(MaterialOutPendingComponent line)
    {
        if (rateText.TryGetValue(line.JwoComponentId, out var value)) return value;
        value = line.Rate.ToString("0.00", CultureInfo.InvariantCulture);
        rateText[line.JwoComponentId] = value;
        return value;
    }

    private void HandleRateInput(ChangeEventArgs e, MaterialOutPendingComponent line)
    {
        if (line.IsProducedComponent) return;
        var text = e.Value?.ToString() ?? string.Empty;
        rateText[line.JwoComponentId] = text;
        if (TryParseQuantity(text, out var value) && value >= 0) line.Rate = value;
    }

    private void NormalizeRateText(MaterialOutPendingComponent line)
    {
        if (line.IsProducedComponent)
        {
            rateText[line.JwoComponentId] = line.Rate.ToString("0.00", CultureInfo.InvariantCulture);
            return;
        }
        if (!rateText.TryGetValue(line.JwoComponentId, out var text) || !TryParseQuantity(text, out var value) || value < 0)
            value = line.Rate;
        line.Rate = Math.Max(0, value);
        rateText[line.JwoComponentId] = line.Rate.ToString("0.00", CultureInfo.InvariantCulture);
    }

    private void HandleRateKeyDown(KeyboardEventArgs e, MaterialOutPendingComponent current)
    {
        if (e.Key == "Escape") { pendingFocusId = $"mo-qty-{current.JwoComponentId}"; return; }
        if (e.Key != "Enter") return;
        NormalizeRateText(current);
        var lines = SelectedLines.ToList();
        var index = lines.FindIndex(x => x.JwoComponentId == current.JwoComponentId);
        pendingFocusId = index >= 0 && index + 1 < lines.Count ? $"mo-qty-{lines[index + 1].JwoComponentId}" : "mo-gst-eway";
    }

