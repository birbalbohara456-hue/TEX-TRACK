    private async Task SaveVoucherAsync()
    {
        if (busy) return;
        foreach (var line in SelectedLines) NormalizeQuantityText(line);
        if (!TryBuildSaveRequest(out var request, out var validationMessage))
        {
            message = validationMessage;
            messageIsError = true;
            pendingFocusId = GetValidationFocusId(validationMessage);
            return;
        }

        busy = true;
        message = string.Empty;
        try
        {
            var savedDestination = destinationGodownText;
            var wasEditing = editingVoucherId is not null;
            request.VoucherId = editingVoucherId ?? 0;
            request.ConcurrencyToken = editingConcurrencyToken;
            var result = editingVoucherId is null
                ? await Repository.SaveAsync(request)
                : await Repository.UpdateAsync(request);
            var savedNumber = result.VoucherNumber;
            if (!string.IsNullOrWhiteSpace(ReturnUrl))
            {
                Navigation.NavigateTo(ReturnUrl);
                return;
            }
            await ResetAfterSaveAsync();
            defaults = await Repository.GetEntryDefaultsAsync();
            showForm = true;
            message = $"Material Out {savedNumber} {(wasEditing ? "updated" : "saved")} successfully. Stock moved to {savedDestination}.";
            messageIsError = false;
            pendingFocusId = defaults.NumberingMode == "Manual" ? "mo-voucher-number" : "mo-job-worker";
        }
        catch (Exception ex)
        {
            message = VoucherErrorMessages.For(ex);
            messageIsError = true;
            pendingFocusId = "mo-save";
        }
        finally
        {
            busy = false;
        }
    }

    private bool TryBuildSaveRequest(out MaterialOutSaveRequest request, out string validationMessage)
    {
        request = new MaterialOutSaveRequest();
        validationMessage = string.Empty;
        if (selectedJobWorkerId is null)
        {
            validationMessage = "Select Party A/c Name.";
            return false;
        }
        if (selectedOrder is null)
        {
            validationMessage = "Select a pending JWO / Order No.";
            return false;
        }
        if (destinationGodownId is null)
        {
            validationMessage = "Select Jobber Destination Godown from the Godown lookup.";
            return false;
        }
        if (defaults.NumberingMode == "Manual" && string.IsNullOrWhiteSpace(defaults.VoucherNumber))
        {
            validationMessage = "Voucher Number is required in Manual numbering mode.";
            return false;
        }

        var lines = new List<MaterialOutSaveLine>();
        foreach (var fg in selectedOrder.FinishedGoods)
        {
            foreach (var line in fg.Components.Where(x => x.IssueNowQuantity > 0))
            {
                if (line.SourceGodownId is null)
                {
                    validationMessage = $"Material Source Godown is missing for component {line.StockItemName}.";
                    return false;
                }
                if (line.IssueNowQuantity > line.PendingQuantity)
                {
                    validationMessage = $"Issue Quantity for {line.StockItemName} exceeds pending quantity.";
                    return false;
                }
                lines.Add(new MaterialOutSaveLine
                {
                    JwoFinishedGoodId = fg.JwoFinishedGoodId,
                    JwoComponentId = line.JwoComponentId,
                    StockItemId = line.StockItemId,
                    UqcId = line.UqcId,
                    SourceGodownId = line.SourceGodownId.Value,
                    IssuedQuantity = line.IssueNowQuantity,
                    Rate = line.Rate
                });
            }
        }
        if (lines.Count == 0)
        {
            validationMessage = "Enter at least one Issue Quantity greater than zero.";
            return false;
        }

        request = new MaterialOutSaveRequest
        {
            VoucherId = editingVoucherId ?? 0,
            ConcurrencyToken = editingConcurrencyToken,
            VoucherTypeId = defaults.VoucherTypeId,
            VoucherNumber = defaults.VoucherNumber,
            VoucherDate = defaults.VoucherDate,
            ReferenceNumber = defaults.ReferenceNumber,
            Batch = batchText,
            JobWorkerLedgerId = selectedJobWorkerId.Value,
            JwoVoucherId = selectedOrder.JwoVoucherId,
            DisplayedOrderNumber = orderNumberText,
            DestinationGodownId = destinationGodownId.Value,
            Narration = narration,
            ProvideGstEwayDetails = gstEwayBillDetails == "Yes",
            EwayDetails = BuildEwayDetails(),
            Lines = lines
        };
        return true;
    }

