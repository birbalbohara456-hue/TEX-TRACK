    private void ToggleReportGroupFromMouse(int index)
    {
        currentMenuIndex = index; currentReportChildIndex = -1;
        var node = ReportMenu[index]; openReportGroup = openReportGroup == node.Key ? null : node.Key;
        pendingFocusId = $"reports-item-{index}";
    }
    private void RememberReportItem(int index) { currentReportChildIndex = -1; lastOriginChildIndex = -1; RememberMenuItem(ReportsMenuName, index); }
    private void RememberReportChild(int index, int child)
    {
        currentReportChildIndex = child; lastOriginChildIndex = child;
        RememberMenuItem(ReportsMenuName, index);
    }
    private void GoToReportChild(int index, int child)
    {
        RememberReportChild(index, child); Navigation.NavigateTo(ReportMenu[index].Items[child].Href);
    }

