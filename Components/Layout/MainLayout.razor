    private void ToggleMasterGroupFromMouse(int groupIndex)
    {
        if (groupIndex < 0 || groupIndex >= MasterGroups.Length) return;

        currentMenuIndex = groupIndex;
        currentMasterChildIndex = -1;
        var key = MasterGroups[groupIndex].Key;
        openMasterGroup = openMasterGroup == key ? null : key;

        // Mouse users keep focus on the group button. Keyboard users enter the
        // child list only through Enter/Right Arrow in HandleKeyDown.
        pendingFocusId = $"masters-item-{groupIndex}";
    }

    private void FocusMasterGroup(int groupIndex)
    {
        currentMenuIndex = groupIndex;
        currentMasterChildIndex = -1;
    }

    private void FocusMasterChild(int groupIndex, int childIndex)
    {
        currentMenuIndex = groupIndex;
        currentMasterChildIndex = childIndex;
    }

    private void RememberMasterChild(int groupIndex, int childIndex)
    {
        if (groupIndex < 0 || groupIndex >= MasterGroups.Length) return;
        var group = MasterGroups[groupIndex];
        if (childIndex < 0 || childIndex >= group.Items.Length) return;
        lastOriginChildIndex = childIndex;
        RememberMenuItem(MastersMenuName, groupIndex);
    }

    private void GoToMasterChild(int groupIndex, int childIndex)
    {
        if (groupIndex < 0 || groupIndex >= MasterGroups.Length) return;
        var group = MasterGroups[groupIndex];
        if (childIndex < 0 || childIndex >= group.Items.Length) return;
        RememberMasterChild(groupIndex, childIndex);
        Navigation.NavigateTo(group.Items[childIndex].Href);
    }

